mainmenu "OWO open firmware (proof of concept)"

config OWO_ADV_INTERVAL_MS
	int "Advertising interval (ms)"
	default 100

config OWO_GECKO_APP_PROPERTIES
	bool "Image descriptor for the Gecko Bootloader"
	default y
	help
	  Put the Silicon Labs ApplicationProperties descriptor in the image and its address in
	  vector slot 13. The Gecko Bootloader and AppLoader in front of the app (0x16000) do not
	  start an image without it (docs/ota.md).

config OWO_GECKO_APP_VERSION
	int "Application version in the image descriptor"
	depends on OWO_GECKO_APP_PROPERTIES
	default 1
	help
	  The stock app carries 1. Kept equal so that neither an update to the open firmware nor
	  a return to stock depends on the bootloader's unknown version policy.

config OWO_SIM_INJECT
	bool "TEST ONLY: command mailbox for the QEMU board simulation"
	help
	  Adds a RAM mailbox (owo_sim_mailbox) that a debugger fills and a 1 ms system work
	  item drains: each entry is handed to the GATT write callback (write_cb) exactly as an
	  ATT write would be after the stack's permission check, or to the disconnect callback.
	  It lets the QEMU board simulation (docs/stim-simulation.md) command stimulation without
	  a Bluetooth connection. Never enable it in a product or hardware build: anything that
	  can write RAM over a debug port could then command output.

config OWO_WATCHDOG
	bool "Short, fixed, locked hardware watchdog (WDOG0)"
	default y
	depends on DT_HAS_SILABS_GECKO_WDOG_ENABLED
	select ZERO_LATENCY_IRQS
	help
	  WDOG0 configured once at boot (src/watchdog.c) and locked: it cannot be stopped or
	  reconfigured afterwards. Fed only by the pump after a supervision pass with the output
	  quiescent (src/wdt.rs); its warning interrupt puts the output stage in its safe state
	  with raw register writes and waits for the reset. docs/watchdog.md.

if OWO_WATCHDOG

config OWO_WATCHDOG_PERSEL
	int "WDOG0 CFG.PERSEL: period of 2^(PERSEL+3)+1 watchdog-clock cycles"
	default 8
	range 0 15
	help
	  Chosen from the longest feed interval measured in QEMU under every workload that can be
	  driven there, with the margin argued in docs/watchdog.md. At 32768 Hz (LFRCO on the
	  suit, LFXO on the kit), 8 is 2049 cycles = 62.53 ms, the stock firmware's value.

config OWO_WATCHDOG_WARNSEL
	int "WDOG0 CFG.WARNSEL: warning at WARNSEL x 25 % of the period"
	default 3
	range 1 3
	help
	  The warning interrupt forces the output safe. Late in the period (75 %) gives the
	  shortest period for a given feed interval, so the reset backstop (for a hang with all
	  interrupts masked) is as short as possible. docs/watchdog.md.

config OWO_WATCHDOG_FREEZE_IN_DEBUG
	bool "Freeze the watchdog while a debugger halts the core (DEBUGRUN = 0)"
	depends on !OWO_STIM_UNVALIDATED_HARDWARE
	help
	  Development builds without a real output stage only. The product keeps the watchdog
	  running in debug halt (DEBUGRUN = 1): a halted core cannot run the warning interrupt, so
	  the reset is the only bound on an output a halt leaves energised.

endif # OWO_WATCHDOG

config OWO_EM2
	bool "Deep sleep (EM2) between radio events and stimulation"
	depends on PM
	depends on !EFR32_RADIO_AMATEUR
	help
	  Let the idle thread enter EM2 whenever nothing needs EM0/EM1: no radio event between its
	  prepare and its end (modules/efr32-radio hal/radio.c), no armed stimulation session and no
	  conversion in flight (src/deep_sleep.c, modules/owo-stim), no clock event closer than the
	  wake-up below (the scheduler clock locks EM2 out while it needs TIMER0), no I2C or UART
	  transfer (their drivers' locks). Without it the product only ever idles in EM1. The
	  amateur identification's radio slot holds no radio reference, so it excludes EM2.
	  docs/radio-tables.md 7.95.

# EM2 exit to a running active clock, what a BURTC wake-up must lead a deadline by
# (docs/radio-tables.md 7.95): the wake-up from EM2 without voltage scaling, 13.22 us (data sheet
# Table 4.10, tEM2_WU); the HFXO start, 5480 FSRCO cycles at 19.804 MHz = 276.71 us, and the
# DPLL lock after it, 11588 HFXO cycles at 38.4 MHz = 301.77 us (7.73, the longest of each), as
# the restore in EMU_EnterEM2() waits for them; the scheduler clock's re-anchor, at most one
# BURTC cycle (30.52 us); and the software from the wake to the active provider's arm. That last
# is the model's [Q]: over 2019 BURTC wake-ups of the product (pairing, GATT and stimulation over
# the link) the compare-to-TIMER0-arm time was at most 666.20 us, less the model's 590.40 us of
# hardware (tEM2_WU, HFXO 5455 cycles, DPLL), 75.80 us, its own re-anchor wait included (so
# counted twice); the model runs the M33's paths up to 35 % short of silicon (7.93), so
# 75.80 / 0.65. Unmeasured on silicon.
OWO_EM2_WAKE_SOFTWARE_NS := 116616
configdefault CLOCK_EVENT_SCHED_DEEP_WAKE_NS
	default $(add,13220,276712,301771,30518,$(OWO_EM2_WAKE_SOFTWARE_NS)) if OWO_EM2

# Module defaults that must precede Zephyr's own (modules/efr32-radio/Kconfig.defaults).
osource "$(ZEPHYR_EFR32_RADIO_MODULE_DIR)/Kconfig.defaults"
source "Kconfig.zephyr"
