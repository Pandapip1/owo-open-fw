# Zephyr split Link Layer (ULL/LLL) lower layer for the EFR32BG22 radio.
#
# UNVALIDATED ON HARDWARE and mostly stubs: see docs/zephyr-ll-port.md and docs/radio-tables.md.
# SPDX-License-Identifier: Apache-2.0

config BT_LLL_VENDOR_EFR32
	bool "Open EFR32BG22 lower link layer for Zephyr's split controller"
	depends on BT_LL_SW_SPLIT
	depends on SOC_SERIES_EFR32BG22 || SOC_SERIES_BGM22
	default y
	# Same feature selection as Zephyr's OpenISA LLL (subsys/bluetooth/controller/
	# Kconfig.ll_sw_split, BT_LLL_VENDOR_OPENISA): legacy advertising/scanning, one-PHY connections,
	# software AES (PSA) and software TIFS. Nothing here is a claim about what the radio can do.
	select BT_HAS_HCI_VS
	# The ticker, launch and QEMU TIFS wake-ups are scheduler clock events, and the
	# ticker count is derived from the scheduler clock's logical timebase.
	select CLOCK_EVENT_SCHED
	select BT_CTLR_ENTROPY_SUPPORT
	select BT_CTLR_CRYPTO_SUPPORT
	select BT_CTLR_LE_ENC_SUPPORT if BT_CTLR_CRYPTO_SUPPORT && !BT_CTLR_DATA_LENGTH_CLEAR
	select BT_CTLR_PRIVACY_SUPPORT if BT_CTLR_CRYPTO_SUPPORT
	select BT_CTLR_PHY_UPDATE_SUPPORT
	select BT_CTLR_EXT_REJ_IND_SUPPORT
	select BT_TICKER_REMAINDER_SUPPORT
	select BT_TICKER_UPDATE if BT_BROADCASTER || BT_CONN
	select PSA_CRYPTO
	# TX/RX launch uses generic deadline-event latches to atomically retain an
	# IRQ publication while its persistent consumer is running.
	select SCHED_DEADLINE
	help
	  Out-of-tree lower link layer ("vendor") for subsys/bluetooth/controller/ll_sw. The LLL
	  sources are derived at configure time from Zephyr's OpenISA LLL (Apache-2.0); only the
	  hardware abstraction in this module is new. Replaces the Silicon Labs binary controller
	  (BT_SILABS_EFR32); the two are mutually exclusive.

if BT_LLL_VENDOR_EFR32

config EFR32_RADIO_STUB_REGISTERS
	bool "Do not touch radio registers (all radio_* hooks are TODO stubs)"
	default y
	help
	  The radio register map is not public (docs/radio-tables.md). While set, the radio HAL only
	  keeps software state and asserts when the controller tries to put a packet on the air.

config EFR32_RADIO_ULL_STACK_SIZE
	int "Upper link layer worker thread stack size"
	default 800
	help
	  Stack of the persistent thread that runs the ticker and ULL mayflies
	  (hal/ll_threads.c), work Zephyr's split controller otherwise runs in a
	  software interrupt. In the QEMU active-scan workload this context peaked
	  at 632 bytes (thread analyzer), so 800 leaves 32 bytes after reserving up
	  to 136 bytes for exception context. It shares one meta-IRQ priority with
	  the LLL and radio's other persistent jobs (EFR32_LL_THREAD_PRIO).

config EFR32_RADIO_LLL_STACK_SIZE
	int "Lower link layer thread stack size"
	default 288
	help
	  Stack of the separate persistent LLL mayfly thread. Keeping it separate
	  lets Zephyr's scheduler order ready LLL and ULL work instead of imposing
	  an order in radio glue. The QEMU active-scan workload peaked at 136 bytes;
	  288 leaves 48 bytes after reserving up to 104 bytes of FP exception
	  context. Revisit both measured budgets when hardware thread analysis is
	  available; they are resource bounds, not radio timing policy.

config EFR32_RADIO_LAUNCH_STACK_SIZE
	int "Persistent radio TX/RX launch job stack size"
	default 448
	help
	  TX and RX launch jobs only wait for a coalescing event latch, claim their generation,
	  and perform the bounded radio arm write. They deliberately do not invoke
	  controller callbacks. Keep their stacks separate from the
	  completion job so its callback budget does not reserve RAM for both launch
	  paths. Arming a wake-up through the scheduler clock service measures about
	  300 bytes (-fstack-usage), plus up to 104 bytes of FP exception context,
	  so 448 leaves about 44 bytes of headroom.

config EFR32_RADIO_COMPLETION_STACK_SIZE
	int "Persistent radio completion job stack size"
	default 768
	help
	  FRC completion work invokes the controller callback after leaving the
	  interrupt context, so it retains a larger, independent stack budget.
	  Real EFR32 hardware also enters the Silicon Labs counter driver's
	  absolute-deadline arm path while this job waits; 512 bytes overflowed
	  there, while QEMU's simpler clock path did not expose the requirement.

config EFR32_RADIO_BRINGUP_TRACE
	bool "Print one-shot radio bring-up checkpoints"
	default n
	help
	  Print the first observed PHY, packet framing, TX FIFO, scheduler launch,
	  and TXEN checkpoints. This is intended for initial silicon bring-up only:
	  printk timing is not part of the controller contract and production and
	  simulator regression images should leave it disabled.

config EFR32_RADIO_QEMU_RX_DESCRIPTOR
	bool "Enable the QEMU-only synthetic RX descriptor consumer"
	default n
	help
	  Enable the opt-in simulator seam that consumes BUFC channel-2 records
	  (class 6/7), copies a bounded PDU from the channel-1 FIFO, and then
	  allows the existing FRC completion callback to run. The normal EFR32
	  hardware build must leave this disabled: the vendor descriptor producer,
	  record validity, and RXDONE ordering are not established on silicon.
		This option is intended only for an explicitly configured in-tree QEMU
		test image.

config EFR32_RADIO_QEMU_TIFS
	bool "Enable QEMU-only scheduler-owned TIFS turn-around"
	default n
	help
		Enable the opt-in simulator seam that schedules the OpenISA TX-to-RX
		turn-around and no-response timeout through persistent Zephyr jobs. The
		transition is armed only after a controller-observed TX completion and
		is cancelled by radio reset, teardown, or event timer stop. It is not a
		model of the EFR32 PROTIMER/RAC TIFS sequencer: leave this disabled for
		hardware builds because packet-end capture, warm-up timing, and HCTO
		semantics remain unproven on silicon. Its persistent event latch uses the
		vendor LLL's generic deadline scheduling support; deadline ordering is not
		a hardware timing claim.

endif # BT_LLL_VENDOR_EFR32

# Starting a kernel timeout runs the scheduler clock arm path on the caller's stack: the
# controller's priority RX thread peaks at 376 of its default 448 bytes (thread analyzer).
configdefault BT_CTLR_RX_PRIO_STACK_SIZE
	default 640 if BT_LLL_VENDOR_EFR32
