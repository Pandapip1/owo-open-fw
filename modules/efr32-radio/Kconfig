config EFR32_RADIO_AMATEUR_CW_TAIL_NS
	int "Morse identification: TXEN to its end beyond the frame's air time (ns)"
	depends on EFR32_RADIO_AMATEUR_ID_CW
	default 363000 if EFR32_RADIO_TIMING_QEMU
	default 7261000
	help
	  From the Morse frame's TXEN to the end of its completion callback,
	  less the frame's nominal air time (its sync and octets at the
	  symbol rate): TX ready, the modem's end of the on-off keyed frame
	  and the completion. The identification's slot and its latest start
	  reserve the frame's air time plus this. Measured
	  (EFR32_RADIO_AMATEUR_ID_PROBE, tests/tx-power-port, docs/radio-tables.md
	  7.89), longest of 10 on silicon: 4327.261 ms for a 4320 ms frame;
	  QEMU 4320.363 ms.
	  Without it a CW-only identification overran its slot on silicon and
	  the frame timer stopped the radio.

config EFR32_RADIO_AMATEUR_SYNTH_PROBE
	bool "Test only: receive-only synthesizer probe, 2290-2500 MHz"
	help
	  For measuring where the synthesizer calibrates and locks
	  (docs/radio-tables.md 7.85): a plan may put any channel anywhere in
	  2290-2500 MHz, in or out of band, and any transmission stops the
	  radio (safe shutdown). Never in an image that transmits.

endif # EFR32_RADIO_AMATEUR

endif # BT_LLL_VENDOR_EFR32

# Starting a kernel timeout runs the scheduler clock arm path on the caller's stack: the
# controller's priority RX thread peaks at 376 of its default 448 bytes (thread analyzer).
configdefault BT_CTLR_RX_PRIO_STACK_SIZE
	default 640 if BT_LLL_VENDOR_EFR32

# A missed or infeasible scheduling deadline puts the radio in a safe state and stops the
# controller (hal/radio.c, k_deadline_miss_handler()), in QEMU and hardware builds alike.
choice SCHED_DEADLINE_MISS_POLICY
	default SCHED_DEADLINE_MISS_CUSTOM if BT_LLL_VENDOR_EFR32
endchoice

# A clock event delivered later than this is a fault of the scheduler clock service (the radio's
# own work is checked against its spec-derived start-by deadlines, hal/efr32/ll_deadlines.h):
# the deep-sleep provider's grid, one 32768 Hz cycle (30518 ns; BURTC COMP is programmed one
# count before the deadline's tick, docs/radio-tables.md 7.73), plus one interrupt the delivering
# interrupt may wait behind (EFR32_RADIO_INTERRUPT_BLOCKING_NS: 58100 silicon, 72400 QEMU).
configdefault CLOCK_EVENT_SCHED_LATE_TOLERANCE_NS
	default 102918 if EFR32_RADIO_TIMING_QEMU
	default 88618 if BT_LLL_VENDOR_EFR32

# Interference ahead of every admitted job: one interrupt (EFR32_RADIO_INTERRUPT_BLOCKING_NS,
# measured). Lower-priority non-preemptible sections cannot delay a meta-IRQ job released from
# an interrupt or from a running thread: the release itself runs after them.
configdefault SCHED_DEADLINE_ADMISSION_BLOCKING_NS
	default EFR32_RADIO_INTERRUPT_BLOCKING_NS if EFR32_RADIO_ADMISSION