config EFR32_RADIO_TEST_QEMU_COUNT_LL_MISSES
	bool "Test only (QEMU): count link-layer deadline misses, stop on broken rules"
	depends on EFR32_RADIO_TIMING_QEMU && SCHED_DEADLINE_MISS_CUSTOM
	help
	  In QEMU every connection-event turnaround misses its spec-derived
	  start-by (docs/radio-tables.md 7.79), so the QEMU connection
	  profiles count misses (SCHED_DEADLINE_MISS_COUNT). That policy
	  cannot carry amateur operation, whose broken rules (an
	  identification not started by its latest start) must still stop
	  the radio. With this, the safe-shutdown handler counts every
	  scheduler miss (efr32_radio_test_ll_miss_count()) and shuts down
	  only on efr32_radio_policy_stop(). Never in a hardware image.

config EFR32_RADIO_TEST_OVERRUN_US
	int "Test only: one injected TX launch job overrun (us)"
	default 0
	help
	  When nonzero, the first TX launch job that runs after
	  EFR32_RADIO_TEST_OVERRUN_AFTER_MS of uptime busy-waits this long after
	  starting the transmission, at the LLL priority, so that the frame's
	  completion job starts late and the missed-deadline policy runs. Leave
	  0 outside that test.

config EFR32_RADIO_TEST_OVERRUN_AFTER_MS
	int "Test only: uptime before the injected overrun (ms)"
	default 2000
	depends on EFR32_RADIO_TEST_OVERRUN_US > 0

config EFR32_RADIO_TX_POWER
	bool "Selectable transmit power"
	default y if BT_CTLR_TX_PWR_DYNAMIC_CONTROL
	help
	  Maps the controller's transmit power in dBm to the 6 dBm power
	  amplifier's level (MODEM.RAMPLEV, hal/tx_power.c): the default
	  from the BT_CTLR_TX_PWR choice, and with
	  BT_CTLR_TX_PWR_DYNAMIC_CONTROL each advertiser's, scanner's and
	  connection's own level (the vendor HCI Write/Read Tx Power Level
	  commands) and LE Read Transmit Power's range. A request gets the
	  highest level whose output, as Silicon Labs publishes it for its
	  reference design, does not exceed it: -27.5 to 8.5 dBm,
	  reported rounded up (-27 to 9). These outputs
	  are not measured on this firmware's boards (docs/tx-power.md).

	  Off, the power amplifier stays at its reset level, its highest
	  (level 127), whatever the controller asks for: the OWO product's
	  setting.

