config EFR32_RADIO_WAKE_LATENCY_NS
	int "Clock-event wake to job dispatch (ns)"
	default 55700
	help
	  A timed command job (TX launch, QEMU TIFS turnaround) is armed this
	  much before its not-before bound; admission models any other timed
	  release as starting this late. The steady-state TIMER0 interrupt
	  without admission (39.4 us) and the TX launch's longest
	  release-to-start (16.3 us), silicon. With admission on, every TX
	  launch on silicon (and in QEMU) was dispatched before its bound: the
	  expiry is delivered within 18.3 us (QEMU 31.9 us) and the job starts
	  at most EFR32_RADIO_SPIN_EXIT_NS after the bound.

config EFR32_RADIO_TIMING_PROBE
	bool "Record the longest radio job paths for a debugger"
	help
	  Keep the longest completion run per kind (advertising/scanning and
	  connection events apart), the completion paths to the PENDING and
	  RESPOND stores, and the held RX launch's paths in struct
	  efr32_radio_probe, in scheduler-clock cycles (the RX hold lateness
	  in TIMER0 counts), for a debugger or the QEMU monitor to read.
	  Measurement builds only (docs/radio-tables.md 7.79).

config EFR32_RADIO_TEST_OVERRUN_US
	int "Test only: one injected TX launch job overrun (us)"
	default 0
	help
	  When nonzero, the first TX launch job that runs after
	  EFR32_RADIO_TEST_OVERRUN_AFTER_MS of uptime busy-waits this long after
	  starting the transmission, at the LLL priority, so that the frame's
	  completion job starts late and the missed-deadline policy runs. Leave
	  0 outside that test.

config EFR32_RADIO_TEST_OVERRUN_AFTER_MS
	int "Test only: uptime before the injected overrun (ms)"
	default 2000
	depends on EFR32_RADIO_TEST_OVERRUN_US > 0

endif # BT_LLL_VENDOR_EFR32

# Starting a kernel timeout runs the scheduler clock arm path on the caller's stack: the
# controller's priority RX thread peaks at 376 of its default 448 bytes (thread analyzer).
configdefault BT_CTLR_RX_PRIO_STACK_SIZE
	default 640 if BT_LLL_VENDOR_EFR32

# A missed or infeasible scheduling deadline puts the radio in a safe state and stops the
# controller (hal/radio.c, k_deadline_miss_handler()), in QEMU and hardware builds alike.
choice SCHED_DEADLINE_MISS_POLICY
	default SCHED_DEADLINE_MISS_CUSTOM if BT_LLL_VENDOR_EFR32
endchoice

# A clock event delivered later than this is a fault of the scheduler clock service (the radio's
# own work is checked against its spec-derived start-by deadlines, hal/efr32/ll_deadlines.h):
# the deep-sleep provider's grid, one 32768 Hz cycle (30518 ns; BURTC COMP is programmed one
# count before the deadline's tick, docs/radio-tables.md 7.73), plus one interrupt the delivering
# interrupt may wait behind (EFR32_RADIO_INTERRUPT_BLOCKING_NS: 58100 silicon, 72400 QEMU).
configdefault CLOCK_EVENT_SCHED_LATE_TOLERANCE_NS
	default 102918 if EFR32_RADIO_TIMING_QEMU
	default 88618 if BT_LLL_VENDOR_EFR32

# Interference ahead of every admitted job: one interrupt (EFR32_RADIO_INTERRUPT_BLOCKING_NS,
# measured). Lower-priority non-preemptible sections cannot delay a meta-IRQ job released from
# an interrupt or from a running thread: the release itself runs after them.
configdefault SCHED_DEADLINE_ADMISSION_BLOCKING_NS
	default EFR32_RADIO_INTERRUPT_BLOCKING_NS if EFR32_RADIO_ADMISSION
