menuconfig OWO_STIM
	bool "OWO stimulation output stage"
	depends on RUST
	select ADC
	select ADC_ASYNC
	select DAC
	select PWM
	select SPI
	select GPIO
	select REGULATOR
	help
	  Per-part drivers and the safety supervisor for the OWO suit's output stage. Needs an
	  "owo,suit-output" devicetree node for the hardware backend (see dts/bindings/misc).

if OWO_STIM

config DAC_LTC2634
	bool "LTC262x-family DAC (Rust driver)"
	default y
	depends on DT_HAS_LLTC_LTC2634_ENABLED
	select SPI
	select GPIO
	help
	  Zephyr DAC API driver whose logic is the Rust crate "ltc2634".

config DAC_LTC2634_INIT_PRIORITY
	int "LTC2634 init priority"
	default 80
	depends on DAC_LTC2634

config OWO_STIM_UNVALIDATED_HARDWARE
	bool "Drive the real output stage (UNVALIDATED, never run on hardware)"
	depends on DT_HAS_OWO_SUIT_OUTPUT_ENABLED
	help
	  Off: the application only logs what it would stimulate. On: the application drives the
	  output stage through the owo-stim supervisor. Read docs/stock-stim-path.md and run the
	  bench checklist in the README first.

config OWO_STIM_HARD_MAX_LEVEL
	int "Hard level ceiling (stock range is 0..126)"
	default 40
	range 1 126

config OWO_STIM_DEADMAN_MS
	int "Dead-man: stop if no frame arrives for this long after the last one ends"
	default 1500

config OWO_STIM_MAX_PHASE_US
	int "Longest allowed phase"
	default 400
	range 1 400
	help
	  Maximum energised duration of either half of a biphasic pulse. The current
	  supervisor performs phase-end and feedback checks in a bounded busy loop;
	  400 us is the safety-reviewed upper bound for that implementation. Do not
	  increase it without replacing the phase loop with a hardware-timed design.

config OWO_STIM_SOFT_START_MS
	int "Soft-start ramp after (re)arming"
	default 500

config OWO_STIM_MAX_DUTY_PERMILLE
	int "Per-channel duty budget (permille of time energised)"
	default 40

config OWO_STIM_WIDTH_SCALE_PERCENT
	int "Pulse width scale vs. the stock table (stock tick suggests 200)"
	default 100
	range 25 200

config OWO_STIM_SENSE_INTERVAL_US
	int "Feedback ADC sampling interval while the supply is on"
	default 100
	help
	  Zephyr's ADC interval is driven by a kernel timer, so the real period is rounded to the
	  system tick resolution.

config OWO_STIM_SENSE_MAX_AGE_US
	int "Longest age of the newest ADC conversion while the bridge is closed"
	default 500

config OWO_STIM_MONITOR_INTERVAL_MS
	int "Safety-monitor job period"
	default 10
	range 1 100
	help
	  Period for the dedicated, highest-preemptive Zephyr thread which applies the
	  stimulation dead-man. Its normal work is only a mutex-protected timestamp
	  check; after expiry it takes the same safe-off path as Stop. The
	  worst-case dead-man reaction is this period plus kernel scheduling latency
	  and a currently executing, bounded pulse. This is not a substitute for the
	  per-phase feedback and overrun checks, which remain in the pulse thread.

config OWO_STIM_MONITOR_STACK_SIZE
	int "Safety-monitor job stack size"
	default 2048
	range 1024 4096
	help
	  Stack for the persistent safety-monitor thread. It must accommodate the
	  Rust supervisor's safe-off path and the Zephyr driver calls it makes after a
	  dead-man expiry. Validate this value with stack sentinel/analysis on the
	  target configuration before enabling hardware output.

config OWO_STIM_FAULT_LOCKOUT
	int "Faults before the whole output locks out until restart"
	default 3

endif # OWO_STIM
