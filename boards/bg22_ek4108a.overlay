/*
 * The stand-in explorer kit. Board-level facts that make the Silicon Labs OTA update keep working
 * with this firmware (docs/ota.md): here the flash map the suit's bootloader expects; the RAM word
 * the bootloader reads, and the rest of what the product needs, are in owo_product.dtsi.
 */
#include "owo_product.dtsi"

/*
 * Flash map. The stock images (GBL, ERASEPROG tag) are written at 0x16000, after the
 * Silicon Labs first/second-stage bootloaders (docs: owo-suit-firmware-analysis.md section 1).
 * The explorer kit's own map (MCUboot at 0x0, slot0 at 0xC000) is replaced by that layout.
 */
&flash0 {
	partitions {
		/delete-node/ partition@0;
		/delete-node/ partition@c000;
		/delete-node/ partition@44000;

		/* Gecko Bootloader (first + second stage), not ours to touch. */
		boot_partition: partition@0 {
			compatible = "zephyr,mapped-partition";
			reg = <0x00000000 DT_SIZE_K(88)>;
			label = "gecko-bootloader";
			read-only;
		};

		/* The application: where the stock GBL puts it, up to the storage partition. */
		slot0_partition: partition@16000 {
			compatible = "zephyr,mapped-partition";
			reg = <0x00016000 DT_SIZE_K(408)>;
			label = "image-0";
		};
	};
};

/* The kit's TIMER0 PWM (LED) gives way to the scheduler clock (owo_product.dtsi). */
&timer0_pwm {
	status = "disabled";
};

/*
 * The kit LED (PA4) moves to the 16-bit TIMER1, CC0. Divided by 32 from EM01GRPACLK
 * (76.8 MHz), it keeps the kit's 20 ms period within 16 bits.
 */
&pinctrl {
	kit_led_pwm: kit_led_pwm {
		group0 {
			pins = <TIMER1_CC0_PA4>;
			drive-push-pull;
			output-high;
		};
	};
};

&timer1 {
	status = "okay";
	clock-div = <32>;

	timer1_pwm: pwm {
		status = "okay";
		pinctrl-0 = <&kit_led_pwm>;
		pinctrl-names = "default";
	};
};

&pwm_led0 {
	pwms = <&timer1_pwm 0 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
};
