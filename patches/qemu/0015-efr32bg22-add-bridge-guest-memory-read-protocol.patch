From a8153e41b6f7f7053225526779d8134facde1cd9 Mon Sep 17 00:00:00 2001
From: Gavin John <gavinnjohn@gmail.com>
Date: Mon, 19 Oct 2026 14:23:43 -0400
Subject: [PATCH] efr32bg22: add bridge guest-memory read protocol

Provide a bounded synchronous read round trip for future trace-backed DMA models without assigning BUFC transfer semantics.

Assisted-By: Codex (GPT-5)
---
 hw/arm/efr32bg22.c                   | 34 +++++++++++++++++++++++++---
 tools/efr32bg22/server.py            | 22 ++++++++++++++++++
 tools/efr32bg22/test_radio_models.py |  8 +++++++
 3 files changed, 61 insertions(+), 3 deletions(-)

diff --git a/hw/arm/efr32bg22.c b/hw/arm/efr32bg22.c
index 92fcbea..a6aabc5 100644
--- a/hw/arm/efr32bg22.c
+++ b/hw/arm/efr32bg22.c
@@ -14,7 +14,9 @@
  *   reply   : u32 value, u32 nwr|flags, u64 irq_mask, u64 next_ns, then nwr x
  *             { u32 addr, u32 len, len bytes padded to 4 } guest memory writes
  *   op: 0 read, 1 write, 2 tick, 3 reset notification
- *   flags (bit 31 of the second word): the server asks for a system reset
+ *   flags: bit 31 asks for a system reset; bit 30 makes this record a guest
+ *          memory-read request (value=address, next_ns=byte count).  QEMU
+ *          replies with that many raw bytes, then receives the normal reply.
  *
  * SPDX-License-Identifier: GPL-2.0-or-later
  */
@@ -67,6 +69,8 @@ typedef struct __attribute__((packed)) {
 
 #define REP_NWR(r)        ((r)->nwr_flags & 0xffff)
 #define REP_RESET         0x80000000u
+#define REP_MEM_READ      0x40000000u
+#define REP_MEM_READ_MAX  (64 * 1024)
 
 struct OwoBridge {
     SysBusDevice parent_obj;
@@ -107,11 +111,35 @@ static uint32_t bridge_xfer(OwoBridge *s, uint8_t op, hwaddr addr,
                     .now_ns = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) };
     BridgeRep r;
 
-    if (qemu_chr_fe_write_all(&s->chr, (uint8_t *)&q, sizeof(q)) != sizeof(q) ||
-        qemu_chr_fe_read_all(&s->chr, (uint8_t *)&r, sizeof(r)) != sizeof(r)) {
+    if (qemu_chr_fe_write_all(&s->chr, (uint8_t *)&q, sizeof(q)) != sizeof(q)) {
         error_report("efr32bg22: peripheral server went away");
         exit(EXIT_FAILURE);
     }
+    do {
+        if (qemu_chr_fe_read_all(&s->chr, (uint8_t *)&r, sizeof(r)) != sizeof(r)) {
+            error_report("efr32bg22: peripheral server went away");
+            exit(EXIT_FAILURE);
+        }
+        if (r.nwr_flags & REP_MEM_READ) {
+            size_t len = r.next_ns;
+            g_autofree uint8_t *buf = NULL;
+
+            if (len > REP_MEM_READ_MAX) {
+                error_report("efr32bg22: oversized memory read from peripheral server");
+                exit(EXIT_FAILURE);
+            }
+            buf = g_malloc0(len);
+            if (address_space_read(&address_space_memory, r.value,
+                                   MEMTXATTRS_UNSPECIFIED, buf, len) != MEMTX_OK) {
+                error_report("efr32bg22: guest memory read for peripheral server failed");
+                exit(EXIT_FAILURE);
+            }
+            if (qemu_chr_fe_write_all(&s->chr, buf, len) != len) {
+                error_report("efr32bg22: peripheral server went away");
+                exit(EXIT_FAILURE);
+            }
+        }
+    } while (r.nwr_flags & REP_MEM_READ);
     for (uint32_t i = 0; i < REP_NWR(&r); i++) {
         uint32_t hdr[2];
         g_autofree uint8_t *buf = NULL;
diff --git a/tools/efr32bg22/server.py b/tools/efr32bg22/server.py
index 85b773d..1da2b9d 100644
--- a/tools/efr32bg22/server.py
+++ b/tools/efr32bg22/server.py
@@ -9,6 +9,7 @@
 REQ = struct.Struct("<BBHIIIQ")
 REP = struct.Struct("<IIQQ")
 RESET_REQ = 0x80000000
+MEM_READ_REQ = 0x40000000
 
 
 class Machine:
@@ -27,6 +28,7 @@ def __init__(self, trace=False):
         self.unknown = collections.Counter()
         self.pinlog = []
         self.mem_writes = []      # (addr, bytes) to apply to guest memory with the next reply
+        self.mem_read = None       # synchronous callback installed by the bridge transport
         self.reset_requested = False
         self.resets = 0
         self.pin_watchers = {}
@@ -82,6 +84,12 @@ def reset(self):
     def guest_write(self, addr, data):
         self.mem_writes.append((addr, bytes(data)))
 
+    def guest_read(self, addr, length):
+        """Read guest RAM through the bridge; models call this only for traced DMA."""
+        if self.mem_read is None:
+            raise RuntimeError("guest-memory reads require the QEMU bridge transport")
+        return self.mem_read(addr, length)
+
     def request_reset(self):
         self.reset_requested = True
 
@@ -140,6 +148,20 @@ def serve(m, path):
     print("listening", path, file=sys.stderr, flush=True)
     c, _ = srv.accept()
     c.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1) if c.family == socket.AF_INET else None
+
+    def read_guest_memory(addr, length):
+        if not 0 <= length <= 64 * 1024:
+            raise ValueError("invalid guest-memory read length")
+        c.sendall(REP.pack(addr, MEM_READ_REQ, 0, length))
+        out = bytearray()
+        while len(out) < length:
+            d = c.recv(length - len(out))
+            if not d:
+                raise ConnectionError("QEMU closed during guest-memory read")
+            out += d
+        return bytes(out)
+
+    m.mem_read = read_guest_memory
     buf = b""
     while True:
         while len(buf) < REQ.size:
diff --git a/tools/efr32bg22/test_radio_models.py b/tools/efr32bg22/test_radio_models.py
index 0edd881..f0d0b77 100644
--- a/tools/efr32bg22/test_radio_models.py
+++ b/tools/efr32bg22/test_radio_models.py
@@ -6,6 +6,7 @@
 
 sys.path.insert(0, str(pathlib.Path(__file__).parent))
 import models
+import server
 
 
 class Machine:
@@ -178,6 +179,13 @@ def test_public_ble_baseline_configuration_masks(self):
             self.assertEqual(dev.read(off), expected)
 
 
+class GuestMemoryTests(unittest.TestCase):
+    def test_model_guest_read_delegates_to_bridge_transport(self):
+        m = server.Machine()
+        m.mem_read = lambda addr, length: bytes((addr + n) & 0xFF for n in range(length))
+        self.assertEqual(m.guest_read(0x20000010, 4), b"\x10\x11\x12\x13")
+
+
 class ModemTests(unittest.TestCase):
     def test_public_sync0_is_a_32_bit_configuration_register(self):
         _, dev = attach(models.Modem("MODEM"))
