From 9b790233a102c152dcff7c983e2c9d415774bb77 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 19 Oct 2026 14:18:42 +0000
Subject: [PATCH 4/5] efr32bg22: radio-block bridge window, radio RAM,
 DEVINFO/USERDATA; per-block fallback devices

The radio register blocks (0xA8000000..) are undocumented in the public SDK; they are
modelled as plain register files, with one inferred self-clearing busy flag. This is
enough for the stock BLE stack init to run past its radio setup, not to talk BLE.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01PdMVRPYdkoKYyoN2UWrcnz
---
 hw/arm/efr32bg22.c        | 53 ++++++++++++++++++++++++++++++++++++---
 tools/efr32bg22/models.py | 25 ++++++++++++++++++
 tools/efr32bg22/server.py |  8 ++++--
 3 files changed, 81 insertions(+), 5 deletions(-)

diff --git a/hw/arm/efr32bg22.c b/hw/arm/efr32bg22.c
index 888cb85..3f1a6d0 100644
--- a/hw/arm/efr32bg22.c
+++ b/hw/arm/efr32bg22.c
@@ -46,6 +46,8 @@ OBJECT_DECLARE_SIMPLE_TYPE(OwoBridge, OWO_BRIDGE)
 
 #define BRIDGE_BASE 0x40000000
 #define BRIDGE_SIZE 0x20000000
+#define RADIO_BASE  0xA8000000
+#define RADIO_SIZE  0x04000000
 #define NUM_IRQ     64
 #define FLASH_SIZE  (512 * 1024)
 #define SRAM_SIZE   (32 * 1024)
@@ -68,6 +70,7 @@ typedef struct __attribute__((packed)) {
 struct OwoBridge {
     SysBusDevice parent_obj;
     MemoryRegion mmio;
+    MemoryRegion mmio_radio;     /* 0xA8000000.. (radio and friends) */
     CharBackend chr;
     qemu_irq irq[NUM_IRQ];
     QEMUTimer *timer;
@@ -94,7 +97,7 @@ static void bridge_apply(OwoBridge *s, const BridgeRep *r)
 static uint32_t bridge_xfer(OwoBridge *s, uint8_t op, hwaddr addr,
                             uint32_t val, unsigned size)
 {
-    BridgeReq q = { .op = op, .size = size, .addr = addr + BRIDGE_BASE,
+    BridgeReq q = { .op = op, .size = size, .addr = addr,
                     .value = val,
                     .now_ns = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) };
     BridgeRep r;
@@ -130,13 +133,24 @@ static uint32_t bridge_xfer(OwoBridge *s, uint8_t op, hwaddr addr,
 
 static uint64_t bridge_read(void *opaque, hwaddr addr, unsigned size)
 {
-    return bridge_xfer(opaque, 0, addr, 0, size);
+    return bridge_xfer(opaque, 0, addr + BRIDGE_BASE, 0, size);
+}
+
+static uint64_t bridge_read_radio(void *opaque, hwaddr addr, unsigned size)
+{
+    return bridge_xfer(opaque, 0, addr + RADIO_BASE, 0, size);
+}
+
+static void bridge_write_radio(void *opaque, hwaddr addr, uint64_t val,
+                               unsigned size)
+{
+    bridge_xfer(opaque, 1, addr + RADIO_BASE, val, size);
 }
 
 static void bridge_write(void *opaque, hwaddr addr, uint64_t val,
                          unsigned size)
 {
-    bridge_xfer(opaque, 1, addr, val, size);
+    bridge_xfer(opaque, 1, addr + BRIDGE_BASE, val, size);
 }
 
 static void bridge_tick(void *opaque)
@@ -152,6 +166,14 @@ static const MemoryRegionOps bridge_ops = {
     .valid.max_access_size = 4,
 };
 
+static const MemoryRegionOps bridge_radio_ops = {
+    .read = bridge_read_radio,
+    .write = bridge_write_radio,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid.min_access_size = 1,
+    .valid.max_access_size = 4,
+};
+
 static void bridge_init(Object *obj)
 {
     OwoBridge *s = OWO_BRIDGE(obj);
@@ -159,6 +181,9 @@ static void bridge_init(Object *obj)
     memory_region_init_io(&s->mmio, obj, &bridge_ops, s, "efr32bg22-periph",
                           BRIDGE_SIZE);
     sysbus_init_mmio(SYS_BUS_DEVICE(obj), &s->mmio);
+    memory_region_init_io(&s->mmio_radio, obj, &bridge_radio_ops, s,
+                          "efr32bg22-radio", RADIO_SIZE);
+    sysbus_init_mmio(SYS_BUS_DEVICE(obj), &s->mmio_radio);
     for (int i = 0; i < NUM_IRQ; i++) {
         sysbus_init_irq(SYS_BUS_DEVICE(obj), &s->irq[i]);
     }
@@ -269,6 +294,28 @@ static void efr32_init(MachineState *machine)
     qdev_prop_set_chr(br, "chardev", chr);
     sysbus_realize_and_unref(SYS_BUS_DEVICE(br), &error_fatal);
     sysbus_mmio_map(SYS_BUS_DEVICE(br), 0, BRIDGE_BASE);
+    sysbus_mmio_map(SYS_BUS_DEVICE(br), 1, RADIO_BASE);
+    {   /* Non-secure alias of the radio block, and the radio RAMs */
+        MemoryRegion *sm = get_system_memory();
+        MemoryRegion *ra = g_new(MemoryRegion, 1);
+        MemoryRegion *radio_ram = g_new(MemoryRegion, 1);
+        MemoryRegion *radio_ram_ns = g_new(MemoryRegion, 1);
+        MemoryRegion *devinfo = g_new(MemoryRegion, 1);
+        SysBusDevice *sbd = SYS_BUS_DEVICE(br);
+
+        memory_region_init_alias(ra, NULL, "radio-ns", sysbus_mmio_get_region(sbd, 1),
+                                 0, RADIO_SIZE);
+        memory_region_add_subregion(sm, 0xB8000000, ra);
+        /* SEQRAM (16K) + FRCRAM (16K) */
+        memory_region_init_ram(radio_ram, NULL, "efr32.radioram", 0x8000, &error_fatal);
+        memory_region_add_subregion(sm, 0xA0000000, radio_ram);
+        memory_region_init_alias(radio_ram_ns, NULL, "efr32.radioram-ns", radio_ram,
+                                 0, 0x8000);
+        memory_region_add_subregion(sm, 0xB0000000, radio_ram_ns);
+        /* USERDATA / DEVINFO / CHIPCONFIG (populated by the server at reset) */
+        memory_region_init_ram(devinfo, NULL, "efr32.devinfo", 0x10000, &error_fatal);
+        memory_region_add_subregion(sm, 0x0FE00000, devinfo);
+    }
     for (int i = 0; i < NUM_IRQ; i++) {
         sysbus_connect_irq(SYS_BUS_DEVICE(br), i, qdev_get_gpio_in(nvic, i));
     }
diff --git a/tools/efr32bg22/models.py b/tools/efr32bg22/models.py
index f4af07f..7106c7a 100644
--- a/tools/efr32bg22/models.py
+++ b/tools/efr32bg22/models.py
@@ -33,6 +33,23 @@ def __init__(self):
         super().__init__("?")
 
 
+class SyncFallback(Fallback):
+    """Unmodelled block whose register at +0x40 is a self-clearing busy flag.  Inferred
+    from the stock firmware (0x199ea..0x199f4 sets bit 0 via the SET alias and spins until
+    it reads 0), not from documentation: the radio register headers are not public."""
+    def r_040(self):
+        return 0
+
+
+SYNC_BLOCKS = (0xA8028000, 0xA802C000)
+
+
+def fallback_for(m, base):
+    d = SyncFallback() if base in SYNC_BLOCKS else Fallback()
+    d.m = m
+    return d
+
+
 class DCDC(Dev):
     """IPVERSION 0, EN 4, CTRL 8 (MODE bit0), IF 0x24, STATUS 0x2C."""
     BYPSW, WARM, RUNNING, REGULATION = 1, 2, 4, 0x20
@@ -946,6 +963,14 @@ def r_07c(self):
         return self.last
 
 def build(m, reset=False, cause=1):
+    # USERDATA/CHIPCONFIG read as erased flash; DEVINFO: only what is known from the
+    # datasheet (sizes) plus a made-up, obviously fake EUI-64. Calibration words are zero.
+    import struct
+    m.guest_write(0x0FE00000, b"\xff" * 0x8000)
+    dev = bytearray(0x2000)
+    struct.pack_into("<I", dev, 0x0C, 512 | (32 << 16))           # MSIZE: flash KiB, SRAM KiB
+    struct.pack_into("<II", dev, 0x48, 0x0000BEEF, 0x00000A00)    # EUI64L/H (fake)
+    m.guest_write(0x0FE08000, bytes(dev))
     m.reset_cause = cause
     m.devs = []
     m.fallback = Fallback()
diff --git a/tools/efr32bg22/server.py b/tools/efr32bg22/server.py
index 2337d9e..5022f42 100644
--- a/tools/efr32bg22/server.py
+++ b/tools/efr32bg22/server.py
@@ -26,6 +26,7 @@ def __init__(self, trace=False):
         self.reset_requested = False
         self.resets = 0
         self.pin_watchers = {}
+        self.fallbacks = {}
         self.spilog, self.spi_slaves = [], {}
         self.adc_inputs, self.adc_log = {}, []
         self.reset_cause_next = 0x40
@@ -82,7 +83,7 @@ def request_reset(self):
 
     # -- bus -------------------------------------------------------------
     def find(self, addr):
-        a = (addr & ~0x10000000) if 0x50000000 <= addr < 0x60000000 else addr
+        a = (addr & ~0x10000000) if (0x50000000 <= addr < 0x60000000 or 0xB8000000 <= addr < 0xBC000000) else addr
         for base, size, dev in self.devs:
             if base <= a < base + size:
                 return dev, a - base
@@ -95,7 +96,10 @@ def access(self, op, addr, val, size):
         off &= 0xFFF
         if dev is None:
             self.unknown[name] += 1
-            dev = self.fallback
+            dev = self.fallbacks.get(name)
+            if dev is None:
+                import models
+                dev = self.fallbacks[name] = models.fallback_for(self, addr & ~0x3FFF)
         if op == 0:
             r = dev.read(off, size)
             key = (addr, r)
-- 
