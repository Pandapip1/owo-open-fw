diff --git a/tools/efr32bg22/gen_resets.py b/tools/efr32bg22/gen_resets.py
new file mode 100644
index 0000000..50405c1
--- /dev/null
+++ b/tools/efr32bg22/gen_resets.py
@@ -0,0 +1,78 @@
+#!/usr/bin/env python3
+"""Generate resets.py (register offsets, names, reset values and IRQ numbers) from the
+Silicon Labs EFR32BG22 device headers.
+Usage: gen_resets.py <path to .../Device/SiliconLabs/EFR32BG22/Include>
+Nested register groups (e.g. GPIO P[n], TIMER CC[n]) are flattened as 'P[1].DOUT'."""
+import glob, os, re, sys
+
+inc = sys.argv[1]
+out = {}
+
+
+def parse_structs(text):
+    """name -> list of (member_name, type, count) in declaration order"""
+    structs = {}
+    for body, name in re.findall(r"typedef struct \{(.*?)\}\s*(\w+)_TypeDef;", text, re.S):
+        mem = []
+        for line in body.split("\n"):
+            mm = re.match(r"\s*(?:__IM|__IOM|__OM)?\s*(\w+)\s+(\w+)(?:\[(\d+)U?\])?;", line)
+            if mm:
+                mem.append((mm.group(2), mm.group(1), int(mm.group(3) or 1)))
+        structs[name] = mem
+    return structs
+
+
+def size_of(structs, name):
+    return sum((4 if t == "uint32_t" else size_of(structs, t[:-len("_TypeDef")])) * c
+               for _, t, c in structs[name])
+
+
+def flatten(structs, name, base, prefix, regs, limit=0x1000):
+    off = base
+    for mname, mtype, cnt in structs[name]:
+        if mtype == "uint32_t":
+            for i in range(cnt):
+                if not mname.startswith("RESERVED") and off - base < limit:
+                    regs[off] = prefix + mname + (f"[{i}]" if cnt > 1 else "")
+                off += 4
+        else:
+            sub = mtype[:-len("_TypeDef")]
+            for i in range(cnt):
+                flatten(structs, sub, off, prefix + mname + (f"[{i}]" if cnt > 1 else "") + ".", regs, 0x10000)
+                off += size_of(structs, sub)
+
+
+ALL = {}
+for path in sorted(glob.glob(os.path.join(inc, "efr32bg22_*.h"))):
+    ALL.update(parse_structs(open(path).read()))
+
+for path in sorted(glob.glob(os.path.join(inc, "efr32bg22_*.h"))):
+    t = open(path).read()
+    stem = os.path.basename(path)[len("efr32bg22_"):-2].upper()
+    structs = ALL
+    if stem not in structs:
+        continue
+    regs = {}
+    flatten(structs, stem, 0, "", regs)
+    # drop the SET/CLR/TGL alias copies (they live at +0x1000/+0x2000/+0x3000)
+    regs = {o: n for o, n in regs.items() if o < 0x1000}
+    res = {}
+    for o, n in regs.items():
+        base = n.split(".")[-1].split("[")[0]
+        rv = re.search(r"#define _%s_%s_RESETVALUE\s+(0x[0-9A-Fa-f]+)" % (stem, base), t) \
+            or re.search(r"#define _%s_%s_RESETVALUE\s+(0x[0-9A-Fa-f]+)" % (stem, n.replace(".", "_").replace("[", "").replace("]", "")), t)
+        res[o] = (n, int(rv.group(1), 16) if rv else 0)
+    out[stem] = res
+
+dev = open(os.path.join(inc, "efr32bg22c224f512im40.h")).read()
+irqs = {n: int(v) for n, v in re.findall(r"^\s*(\w+)_IRQn\s*=\s*(\d+),", dev, re.M)}
+with open(os.path.join(os.path.dirname(os.path.abspath(__file__)), "resets.py"), "w") as f:
+    f.write("# Generated by gen_resets.py from the EFR32BG22 device headers (Zlib licensed SDK).\n")
+    f.write("REGS = {\n")
+    for p, regs in out.items():
+        f.write("    %r: {\n" % p)
+        for o, (n, v) in sorted(regs.items()):
+            f.write("        0x%03x: (%r, 0x%08x),\n" % (o, n, v))
+        f.write("    },\n")
+    f.write("}\nIRQS = %r\n" % irqs)
+print("wrote", len(out), "peripherals")
diff --git a/tools/efr32bg22/models.py b/tools/efr32bg22/models.py
new file mode 100644
index 0000000..23595b4
--- /dev/null
+++ b/tools/efr32bg22/models.py
@@ -0,0 +1,762 @@
+"""EFR32BG22 peripheral models (register level, just enough to run firmware)."""
+import struct
+import resets
+
+
+class Dev:
+    """Register file with reset values; subclasses add read_<off>/write_<off> hooks."""
+    name = "dev"
+
+    def __init__(self, name, kind=None):
+        self.name = name
+        self.m = None
+        kind = kind or name.rstrip("0123456789")
+        self.regs = {off: v for off, (_, v) in resets.REGS.get(kind, {}).items()}
+
+    def read(self, off, size=4):
+        h = getattr(self, "r_%03x" % (off & ~3), None)
+        if h:
+            return h()
+        return self.regs.get(off & ~3, 0)
+
+    def write(self, off, val):
+        h = getattr(self, "w_%03x" % off, None)
+        if h:
+            h(val)
+        else:
+            self.regs[off] = val & 0xFFFFFFFF
+
+
+class Fallback(Dev):
+    """Anything unmodelled: plain read/write memory, so software sees what it wrote."""
+    def __init__(self):
+        super().__init__("?")
+
+
+class DCDC(Dev):
+    """IPVERSION 0, EN 4, CTRL 8 (MODE bit0), IF 0x24, STATUS 0x2C."""
+    BYPSW, WARM, RUNNING, REGULATION = 1, 2, 4, 0x20
+
+    def _settle(self):
+        mode = self.regs.get(0x008, 0) & 1
+        if mode:
+            self.regs[0x024] = self.regs.get(0x024, 0) | self.WARM | self.RUNNING | self.REGULATION
+            self.regs[0x02C] = self.WARM | self.RUNNING
+        else:
+            self.regs[0x024] = self.regs.get(0x024, 0) | self.BYPSW
+            self.regs[0x02C] = self.BYPSW
+
+    def w_008(self, v):
+        self.regs[0x008] = v
+        self.m.after(20_000, self._settle)
+
+    def r_02c(self):
+        return self.regs.get(0x02C, self.BYPSW)
+
+
+class Osc(Dev):
+    """On-demand oscillator.  ON when CTRL.FORCEEN (bit0 of ctrl_off) or when a
+    consumer requests it (request(m) -> bool).  STATUS shows RDY|ENS while on."""
+    def __init__(self, name, status_off, ctrl_off=None, request=None, always=False):
+        super().__init__(name)
+        self.ctrl_off, self.request, self.always = ctrl_off, request, always
+        setattr(self, "r_%03x" % status_off, self.status)
+
+    def on(self):
+        if self.always:
+            return True
+        if self.ctrl_off is not None and self.regs.get(self.ctrl_off, 0) & 1:
+            return True
+        return bool(self.request and self.request(self.m))
+
+    def status(self):
+        return (1 | 1 << 16) if self.on() else 0
+
+
+class HFXO(Dev):
+    """Starts when forced (CTRL.FORCEEN) or when something requests it (m.hfxo_requested).
+    FSMLOCK is set while the oscillator state machine owns the core bias; a
+    MANUALOVERRIDE command (CMD bit1) releases it."""
+    ON = 1 | 2 | 1 << 16 | 1 << 17 | 1 << 19
+
+    def __init__(self, name):
+        super().__init__(name)
+        self.lock = True
+
+    def on(self):
+        return bool(self.regs.get(0x028, 0) & 1) or self.m.hfxo_requested()
+
+    def r_058(self):
+        if not self.on():
+            self.lock = True
+            return 0
+        return self.ON | (1 << 30 if self.lock else 0)
+
+    def w_050(self, v):
+        if v & 2:
+            self.lock = False
+
+
+class RadioAES(Dev):
+    """BA411 front-end: idle (WAITING only); crypto operations are not performed."""
+    def r_03c(self):
+        return 0x20
+
+
+class TRNG(Dev):
+    """CRYPTOACC BA431 TRNG.
+
+    Normal mode: after NDRNG_ENABLE the state machine reaches FIFOFULL and the
+    FIFO stays full (data is a fixed-seed xorshift stream, NOT random).
+    Conditioning test mode (CTRL.TEST_ENABLE): TESTDATA words are fed through the
+    conditioning function, AES-128-CBC with IV 0 keyed by KEY0..3 (little-endian
+    words), and the last block is pushed to the FIFO after NB_128BIT_BLOCKS blocks
+    (checked against the SDK known-answer test).
+    Registers: 0 CTRL, 4 FIFOLEVEL, 0xC FIFODEPTH, 0x10..0x1C KEY, 0x20 TESTDATA,
+    0x30 STATUS."""
+    DEPTH = 64
+    STARTUP, FIFOFULLON = 2, 4
+
+    def __init__(self, name, kind=None):
+        super().__init__(name, kind)
+        self.state = 0
+        self.fifo = []
+        self.tbuf = b""
+        self.cbc = None
+        self.x = 0x2545F491
+        self.nb = 4
+
+    def rnd(self):
+        x = self.x
+        x ^= (x << 13) & 0xFFFFFFFF
+        x ^= x >> 17
+        x ^= (x << 5) & 0xFFFFFFFF
+        self.x = x
+        return x
+
+    def pop(self):
+        if self.test_mode():
+            return self.fifo.pop(0) if self.fifo else 0
+        return self.rnd()
+
+    def test_mode(self):
+        return bool(self.regs.get(0x000, 0) & 4)
+
+    def level(self):
+        if self.test_mode():
+            return len(self.fifo)
+        return self.DEPTH if self.state >= self.FIFOFULLON else 0
+
+    def w_000(self, v):
+        old = self.regs.get(0x000, 0)
+        self.regs[0x000] = v
+        if (v >> 16) & 0xF:
+            self.nb = (v >> 16) & 0xF       # the SDK writes CTRL after NB_128BIT_BLOCKS without it; the
+                                            # block count is sticky (needed for the SDK's own self-test to pass)
+        if v & 0x100 or (v & 4 and not old & 4):          # SOFTRESET / entering test mode
+            self.fifo, self.tbuf, self.cbc, self.state = [], b"", None, 0
+        if v & 1 and not old & 1:
+            self.state = self.STARTUP
+            self.m.after(50_000, lambda: setattr(self, "state", self.FIFOFULLON))
+        if not v & 1 and not v & 4:
+            self.state = 0
+
+    def r_004(self):
+        return self.level()
+
+    def r_00c(self):
+        return self.DEPTH
+
+    def w_020(self, v):                                    # TESTDATA
+        if not self.test_mode():
+            return
+        self.tbuf += struct.pack("<I", v)
+        if len(self.tbuf) == 16:
+            from cryptography.hazmat.primitives.ciphers import Cipher, algorithms, modes
+            key = b"".join(struct.pack("<I", self.regs.get(o, 0)) for o in (0x10, 0x14, 0x18, 0x1C))
+            if self.cbc is None:
+                self.cbc = bytes(16)
+                self.nblk = 0
+            enc = Cipher(algorithms.AES(key), modes.CBC(self.cbc)).encryptor()
+            self.cbc = enc.update(self.tbuf) + enc.finalize()
+            self.tbuf = b""
+            self.nblk += 1
+            if self.nblk == self.nb:
+                self.fifo += list(struct.unpack("<4I", self.cbc))
+                self.cbc = None
+
+    def r_030(self):                                       # STATUS: STATE in bits 3:1
+        return self.state << 1 if not self.test_mode() else 0
+
+
+class TRNGFifo(Dev):
+    def __init__(self, name, trng):
+        super().__init__(name, "")
+        self.trng = trng
+
+    def read(self, off, size=4):
+        return self.trng.pop()
+
+
+class IrqDev(Dev):
+    """Device with IF/IEN registers that drives one NVIC line (IF & IEN)."""
+    irq_name = None
+    IF_OFF, IEN_OFF = 0, 0
+
+    def irq_update(self):
+        n = resets.IRQS.get(self.irq_name)
+        if n is not None:
+            self.m.set_irq(n, bool(self.regs.get(self.IF_OFF, 0) & self.regs.get(self.IEN_OFF, 0)))
+
+    def raise_if(self, bits):
+        self.regs[self.IF_OFF] = self.regs.get(self.IF_OFF, 0) | bits
+        self.irq_update()
+
+    def write(self, off, val):
+        super().write(off, val)
+        if off in (self.IF_OFF, self.IEN_OFF):
+            self.irq_update()
+
