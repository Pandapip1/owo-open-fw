From 589587aadb89af75e29d2b518417f68933c20621 Mon Sep 17 00:00:00 2001
From: Gavin John <gavinnjohn@gmail.com>
Date: Mon, 19 Oct 2026 13:49:05 -0400
Subject: [PATCH] efr32bg22: model public RFCRC configuration registers

Constrain RFCRC configuration to the public revB2 register masks while leaving FRC packet-pipeline behavior unmodelled.

Assisted-By: Codex (GPT-5)
---
 tools/efr32bg22/models.py            | 28 ++++++++++++++++++++++++++++
 tools/efr32bg22/test_radio_models.py | 15 +++++++++++++++
 2 files changed, 43 insertions(+)

diff --git a/tools/efr32bg22/models.py b/tools/efr32bg22/models.py
index 70bef62..e5b02b7 100644
--- a/tools/efr32bg22/models.py
+++ b/tools/efr32bg22/models.py
@@ -438,6 +438,33 @@ def write(self, off, val):
             super().write(off, val)
 
 
+class RFCRC(Dev):
+    """EFR32xG22 RFCRC register file from the public revB2 model.
+
+    This records configuration and exposes the documented masks.  Feeding the
+    FRC packet pipeline and calculating DATA are sequencer behavior, not yet
+    represented by the bridge.
+    """
+    EN, CTRL, STATUS, CMD = 0x004, 0x008, 0x00C, 0x010
+    INPUTDATA, INIT, DATA, POLY = 0x014, 0x018, 0x01C, 0x020
+    MASKS = {
+        EN: 0x00000001,
+        CTRL: 0x00001FEF,
+        INIT: 0xFFFFFFFF,
+        POLY: 0xFFFFFFFF,
+    }
+
+    def write(self, off, val):
+        if off in self.MASKS:
+            self.regs[off] = val & self.MASKS[off]
+        elif off == self.CMD:
+            pass                            # INITIALIZE is sequencer-owned here.
+        elif off == self.INPUTDATA:
+            pass                            # Packet CRC calculation is unmodelled.
+        else:
+            super().write(off, val)
+
+
 class PCF8575:
     """16-bit quasi-bidirectional I/O expander.  Two data bytes per transfer, P0-P7 first."""
     def __init__(self, addr7=0x20):
@@ -1257,6 +1284,7 @@ def build(m, reset=False, cause=1):
     m.add(USART("USART1", "USART1_RX"), 0x40060000)
     m.rac = m.add(RAC("RAC"), 0xA8020000)
     m.synth = m.add(Synth("SYNTH"), 0xA8018000)
+    m.rfcrc = m.add(RFCRC("RFCRC"), 0xA8010000)
     m.bufc = m.add(BUFC("BUFC"), 0xAA000000)
     trng = m.add(TRNG("TRNG", ""), 0x4C021000, 0x1000)
     m.add(TRNGFifo("TRNGFIFO", trng), 0x4C024000, 0x1000)
diff --git a/tools/efr32bg22/test_radio_models.py b/tools/efr32bg22/test_radio_models.py
index eba48a0..192d0e7 100644
--- a/tools/efr32bg22/test_radio_models.py
+++ b/tools/efr32bg22/test_radio_models.py
@@ -118,5 +118,20 @@ def test_public_xg22_channel_and_frequency_field_masks(self):
         self.assertEqual(dev.read(dev.CHSP), 0x0002BCDE)
 
 
+class RfcrcTests(unittest.TestCase):
+    def test_public_configuration_masks_and_command_side_effects(self):
+        _, dev = attach(models.RFCRC("RFCRC"))
+        dev.write(dev.EN, 3)
+        dev.write(dev.CTRL, 0xFFFFF7FF)
+        dev.write(dev.INIT, 0x00AAAAAA)
+        dev.write(dev.POLY, 0x00DA6000)
+        dev.write(dev.CMD, 1)
+        self.assertEqual(dev.read(dev.EN), 1)
+        self.assertEqual(dev.read(dev.CTRL), 0x000017EF)
+        self.assertEqual(dev.read(dev.INIT), 0x00AAAAAA)
+        self.assertEqual(dev.read(dev.POLY), 0x00DA6000)
+        self.assertEqual(dev.read(dev.STATUS), 0)
+
+
 if __name__ == "__main__":
     unittest.main()
