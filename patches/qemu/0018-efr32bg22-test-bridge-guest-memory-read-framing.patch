From: Gavin John <gavinnjohn@gmail.com>
Date: Mon, 19 Oct 2026 15:00:51 -0400
Subject: [PATCH] efr32bg22: test bridge guest-memory read framing

Exercise the server-side framed read request and payload exchange over a socket pair.

Assisted-By: Codex (GPT-5)
---
 tools/efr32bg22/server.py            | 31 ++++++++++++++++------------
 tools/efr32bg22/test_radio_models.py | 17 +++++++++++++++
 2 files changed, 35 insertions(+), 13 deletions(-)

diff --git a/tools/efr32bg22/server.py b/tools/efr32bg22/server.py
index 1da2b9d..f86dc98 100644
--- a/tools/efr32bg22/server.py
+++ b/tools/efr32bg22/server.py
@@ -139,6 +139,23 @@ def access(self, op, addr, val, size):
         return 0
 
 
+def guest_memory_reader(sock):
+    """Build the synchronous server-side half of the bridge memory-read exchange."""
+    def read(addr, length):
+        if not 0 <= length <= 64 * 1024:
+            raise ValueError("invalid guest-memory read length")
+        sock.sendall(REP.pack(addr, MEM_READ_REQ, 0, length))
+        out = bytearray()
+        while len(out) < length:
+            data = sock.recv(length - len(out))
+            if not data:
+                raise ConnectionError("QEMU closed during guest-memory read")
+            out += data
+        return bytes(out)
+
+    return read
+
+
 def serve(m, path):
     if os.path.exists(path):
         os.unlink(path)
@@ -149,19 +166,7 @@ def serve(m, path):
     c, _ = srv.accept()
     c.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1) if c.family == socket.AF_INET else None
 
-    def read_guest_memory(addr, length):
-        if not 0 <= length <= 64 * 1024:
-            raise ValueError("invalid guest-memory read length")
-        c.sendall(REP.pack(addr, MEM_READ_REQ, 0, length))
-        out = bytearray()
-        while len(out) < length:
-            d = c.recv(length - len(out))
-            if not d:
-                raise ConnectionError("QEMU closed during guest-memory read")
-            out += d
-        return bytes(out)
-
-    m.mem_read = read_guest_memory
+    m.mem_read = guest_memory_reader(c)
     buf = b""
     while True:
         while len(buf) < REQ.size:
diff --git a/tools/efr32bg22/test_radio_models.py b/tools/efr32bg22/test_radio_models.py
index dcb3005..7be951b 100644
--- a/tools/efr32bg22/test_radio_models.py
+++ b/tools/efr32bg22/test_radio_models.py
@@ -1,7 +1,9 @@
 #!/usr/bin/env python3
 import heapq
 import pathlib
+import socket
 import sys
+import threading
 import unittest
 
 sys.path.insert(0, str(pathlib.Path(__file__).parent))
@@ -192,6 +194,21 @@ def test_model_guest_read_delegates_to_bridge_transport(self):
         m.mem_read = lambda addr, length: bytes((addr + n) & 0xFF for n in range(length))
         self.assertEqual(m.guest_read(0x20000010, 4), b"\x10\x11\x12\x13")
 
+    def test_bridge_memory_read_frame_and_payload(self):
+        server_sock, qemu_sock = socket.socketpair()
+        result = []
+        reader = server.guest_memory_reader(server_sock)
+        worker = threading.Thread(target=lambda: result.append(reader(0x20000010, 4)))
+        worker.start()
+        request = qemu_sock.recv(server.REP.size)
+        self.assertEqual(server.REP.unpack(request),
+                         (0x20000010, server.MEM_READ_REQ, 0, 4))
+        qemu_sock.sendall(b"\x10\x11\x12\x13")
+        worker.join()
+        self.assertEqual(result, [b"\x10\x11\x12\x13"])
+        server_sock.close()
+        qemu_sock.close()
+
 
 class ModemTests(unittest.TestCase):
     def test_public_sync0_is_a_32_bit_configuration_register(self):
