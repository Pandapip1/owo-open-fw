From 34d49e7e134dbc8c77e4a4ffaf9a23d66dcb2934 Mon Sep 17 00:00:00 2001
From: Gavin John <gavinnjohn@gmail.com>
Date: Mon, 19 Oct 2026 14:08:39 -0400
Subject: [PATCH] efr32bg22: retain public BLE FRC configuration fields

Model source-decoded length, control and frame-descriptor registers without packet-pipeline behavior.

Assisted-By: Codex (GPT-5)
---
 tools/efr32bg22/models.py            | 11 ++++++++++-
 tools/efr32bg22/test_radio_models.py | 11 +++++++++++
 2 files changed, 21 insertions(+), 1 deletion(-)

diff --git a/tools/efr32bg22/models.py b/tools/efr32bg22/models.py
index dfea883..319754b 100644
--- a/tools/efr32bg22/models.py
+++ b/tools/efr32bg22/models.py
@@ -466,17 +466,26 @@ def write(self, off, val):
 
 
 class FRC(Dev):
-    """Public xG22 FRC whitening configuration registers.
+    """Public xG22 FRC BLE configuration registers.
 
     The packet pipeline, including applying the whitening LFSR, belongs to
     FRC/SEQ behavior and is deliberately not modelled here.  Retaining these
     public register masks makes the source-backed BLE setup observable.
     """
+    MAXLENGTH = 0x010
     WHITECTRL, WHITEPOLY, WHITEINIT = 0x030, 0x034, 0x038
+    CTRL = 0x048
+    FCD0, FCD1, FCD2, FCD3 = 0x104, 0x108, 0x10C, 0x110
     MASKS = {
+        MAXLENGTH: 0x0000FFFF,
         WHITECTRL: 0x00001F7F,
         WHITEPOLY: 0x0000FFFF,
         WHITEINIT: 0x0000FFFF,
+        CTRL: 0x001F3FF7,
+        FCD0: 0x0001FFFF,
+        FCD1: 0x0001FFFF,
+        FCD2: 0x0001FFFF,
+        FCD3: 0x0001FFFF,
     }
 
     def write(self, off, val):
diff --git a/tools/efr32bg22/test_radio_models.py b/tools/efr32bg22/test_radio_models.py
index 002be08..ba765e5 100644
--- a/tools/efr32bg22/test_radio_models.py
+++ b/tools/efr32bg22/test_radio_models.py
@@ -143,6 +143,17 @@ def test_public_whitening_configuration_masks(self):
         self.assertEqual(dev.read(dev.WHITEPOLY), 0x0000ABCD)
         self.assertEqual(dev.read(dev.WHITEINIT), 0x00001234)
 
+    def test_public_ble_frame_configuration_masks(self):
+        _, dev = attach(models.FRC("FRC"))
+        dev.write(dev.MAXLENGTH, 0xFFFF4101)
+        dev.write(dev.CTRL, 0xFFFF07A0)
+        for off in (dev.FCD0, dev.FCD1, dev.FCD2, dev.FCD3):
+            dev.write(off, 0xFFFF4CFF)
+        self.assertEqual(dev.read(dev.MAXLENGTH), 0x00004101)
+        self.assertEqual(dev.read(dev.CTRL), 0x001F07A0)
+        for off in (dev.FCD0, dev.FCD1, dev.FCD2, dev.FCD3):
+            self.assertEqual(dev.read(off), 0x00014CFF)
+
 
 class ModemTests(unittest.TestCase):
     def test_public_sync0_is_a_32_bit_configuration_register(self):
