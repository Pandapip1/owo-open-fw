From afa9db272269685c2bd19238f0acd01f2701db65 Mon Sep 17 00:00:00 2001
From: Gavin John <gavinnjohn@gmail.com>
Date: Mon, 19 Oct 2026 14:38:25 -0400
Subject: [PATCH] efr32bg22: correct BUFC threshold interrupt bits

Use the public per-buffer IF/IEN threshold-bit layout rather than a synthetic compact bitmap.

Assisted-By: Codex (GPT-5)
---
 tools/efr32bg22/models.py            | 4 +++-
 tools/efr32bg22/test_radio_models.py | 3 ++-
 2 files changed, 5 insertions(+), 2 deletions(-)

diff --git a/tools/efr32bg22/models.py b/tools/efr32bg22/models.py
index 7a20782..27bf627 100644
--- a/tools/efr32bg22/models.py
+++ b/tools/efr32bg22/models.py
@@ -267,7 +267,9 @@ def update_threshold(self, n):
         cfg = self.regs.get(base + 0x24, 0)
         threshold = cfg & 0xFFF
         hit = len(self.data[n]) <= threshold if cfg & 0x2000 else len(self.data[n]) > threshold
-        bit = 1 << n
+        # Public xG21 BUFC_IF places each buffer's threshold flag at bit
+        # 8*n+2 (BUF0THR=2, BUF1THR=10, BUF2THR=18, BUF3THR=26).
+        bit = 1 << (8 * n + 2)
         if hit:
             self.regs[self.IF_OFF] = self.regs.get(self.IF_OFF, 0) | bit
         else:
diff --git a/tools/efr32bg22/test_radio_models.py b/tools/efr32bg22/test_radio_models.py
index 78419c1..dcb3005 100644
--- a/tools/efr32bg22/test_radio_models.py
+++ b/tools/efr32bg22/test_radio_models.py
@@ -57,10 +57,11 @@ def test_programmed_io_offsets_status_and_contents(self):
     def test_xwrite_clear_threshold_and_irq(self):
         machine, dev = attach(models.BUFC("BUFC"))
         base = dev.BUF0 + dev.STRIDE
-        dev.write(dev.IEN_OFF, 1 << 1)
+        dev.write(dev.IEN_OFF, 1 << (8 * 1 + 2))
         dev.write(base + 0x24, 0)             # larger than zero
         dev.write(base + 0x1C, 0x55)
         self.assertEqual(dev.contents(1), b"U")
+        self.assertEqual(dev.read(dev.IF_OFF), 1 << 10)
         self.assertTrue(machine.irq & (1 << models.resets.IRQS["BUFC"]))
         dev.write(base + 0x28, 1)
         self.assertEqual(dev.contents(1), b"")
-- 
