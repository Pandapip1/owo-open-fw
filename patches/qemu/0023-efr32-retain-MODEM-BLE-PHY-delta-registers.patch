From ef4b7ccc7da29c108f583895d3d9a49c322e3e3f Mon Sep 17 00:00:00 2001
From: Gavin John <gavinnjohn@gmail.com>
Date: Mon, 19 Oct 2026 15:19:49 -0400
Subject: [PATCH] efr32: retain MODEM BLE PHY delta registers

Assisted-By: Codex (GPT-5)
---
 tools/efr32bg22/models.py            | 29 ++++++++++++++++++++++++----
 tools/efr32bg22/test_radio_models.py | 13 +++++++++++++
 2 files changed, 38 insertions(+), 4 deletions(-)

diff --git a/tools/efr32bg22/models.py b/tools/efr32bg22/models.py
index 9c747ac..aaa0849 100644
--- a/tools/efr32bg22/models.py
+++ b/tools/efr32bg22/models.py
@@ -533,17 +533,25 @@ class Modem(Dev):
     MIXCTRL = 0x01C
     CTRL0, CTRL1, CTRL2, CTRL3, CTRL4, CTRL5, CTRL6 = (0x020 + 4 * n for n in range(7))
     TXBR, RXBR, CF, PRE, SYNC0, SYNC1 = (0x058 + 4 * n for n in range(6))
+    SHAPING1, SHAPING2, SHAPING3, SHAPING4, SHAPING5 = (0x098 + 4 * n for n in range(5))
+    SHAPING6, SHAPING7, SHAPING8, SHAPING9 = (0x0AC + 4 * n for n in range(4))
     SHAPING10, SHAPING11 = 0x0BC, 0x0C0
-    DCCOMP, DCCOMPFILTINIT = 0x0E0, 0x0E4
+    DCCOMP, DCCOMPFILTINIT, SRCCHF = 0x0E0, 0x0E4, 0x0EC
     DSATHD0, DSATHD1 = 0x0F4, 0x0F8
+    DSACTRL, VITERBIDEMOD, VTCORRCFG0 = 0x0FC, 0x100, 0x104
+    DIGMIXCTRL, VTCORRCFG1, VTTRACK = 0x10C, 0x110, 0x114
     AUTOCG = 0x124
-    DSATHD2, DIRECTMODE = 0x130, 0x134
+    CGCLKSTOP, DSATHD2, DIRECTMODE = 0x128, 0x130, 0x134
+    LONGRANGE, LONGRANGE1, LONGRANGE2, LONGRANGE3 = 0x138, 0x13C, 0x140, 0x144
+    LONGRANGE4, LONGRANGE5, LONGRANGE6 = 0x148, 0x14C, 0x150
     LRFRC, DSATHD3, DSATHD4 = 0x154, 0x168, 0x16C
+    VTBLETIMING = 0x170
     BLEIQDSA, SYNCPROPERTIES = 0x230, 0x238
+    BLEIQDSAEXT1, REALTIMCFE = 0x234, 0x248
     DIGIGAINCTRL, PADEBUG = 0x23C, 0x244
     ETSCTRL, ANTSWCTRL, ANTSWSTART, ANTSWEND = 0x254, 0x258, 0x25C, 0x260
     TRECPMPATT, TRECPMDET, CFGANTPATT, ETSTIM = 0x264, 0x268, 0x26C, 0x270
-    ANTSWCTRL1, ANTDIVCTRL, BLEIQDSAEXT2 = 0x274, 0x27C, 0x280
+    ANTSWCTRL1, COCURRMODE, ANTDIVCTRL, BLEIQDSAEXT2 = 0x274, 0x278, 0x27C, 0x280
     MASKS = {
         MIXCTRL: 0x0000001F,
         CTRL0: 0xFFFFFFFF, CTRL1: 0xFFFFDFFF, CTRL2: 0xFFFFFFFF,
@@ -551,16 +559,29 @@ class Modem(Dev):
         CTRL6: 0xF6000000, TXBR: 0x00FFFFFF, RXBR: 0x00001FFF,
         CF: 0xCFFFFFFF, PRE: 0xFFFF1FFF, SYNC0: 0xFFFFFFFF,
         SYNC1: 0xFFFFFFFF, SHAPING10: 0xFFFFFFFF, SHAPING11: 0xFFFFFFFF,
+        SHAPING1: 0xFFFFFFFF, SHAPING2: 0xFFFFFFFF, SHAPING3: 0xFFFFFFFF,
+        SHAPING4: 0xFFFFFFFF, SHAPING5: 0xFFFFFFFF, SHAPING6: 0xFFFFFFFF,
+        SHAPING7: 0xFFFFFFFF, SHAPING8: 0xFFFFFFFF, SHAPING9: 0xFFFFFFFF,
         DCCOMP: 0x000001FF, DCCOMPFILTINIT: 0x7FFFFFFF,
+        SRCCHF: 0xEFFFF8FF, DSACTRL: 0xFFEFFFFF, VITERBIDEMOD: 0xFFFFFFFF,
+        VTCORRCFG0: 0xFFFFFFFF, DIGMIXCTRL: 0x007FFFFF,
+        VTCORRCFG1: 0x7FFFFFFF, VTTRACK: 0xFFFFFFFF,
         DSATHD0: 0xFFFFFFFF, DSATHD1: 0x7FFFFFFF, AUTOCG: 0x0000FFFF,
+        CGCLKSTOP: 0x0000FFFF,
         DSATHD2: 0x7FFFFEFF, DIRECTMODE: 0x00001F0F, LRFRC: 0x000001FF,
+        LONGRANGE: 0x7FFFFFFF, LONGRANGE1: 0x3FFF7FFF,
+        LONGRANGE2: 0xFFFFFFFF, LONGRANGE3: 0xFFFFFFFF,
+        LONGRANGE4: 0xFFFFFFFF, LONGRANGE5: 0x0FFFFFFF,
+        LONGRANGE6: 0xFFF7FFFF,
         DSATHD3: 0xFFFFFFFF, DSATHD4: 0x07FFFFFF, BLEIQDSA: 0xFFFFFFFF,
+        VTBLETIMING: 0x0000FFF3, BLEIQDSAEXT1: 0x3FFFFFFF,
+        REALTIMCFE: 0xE01FFFFF,
         SYNCPROPERTIES: 0x000000FF, DIGIGAINCTRL: 0x000001FF,
         PADEBUG: 0x00001E00, ETSCTRL: 0x3FFFF7FF, ANTSWCTRL: 0x01FFFFFF,
         ANTSWSTART: 0x0003FFFF, ANTSWEND: 0x0003FFFF,
         TRECPMPATT: 0xFFFFFFFF, TRECPMDET: 0xBFFFC3FF,
         CFGANTPATT: 0x3FFFFFFF, ETSTIM: 0x0003FFFF,
-        ANTSWCTRL1: 0x00FFFFFF, ANTDIVCTRL: 0x000001FF,
+        ANTSWCTRL1: 0x00FFFFFF, COCURRMODE: 0x80000000, ANTDIVCTRL: 0x000001FF,
         BLEIQDSAEXT2: 0x000007FF,
     }
 
diff --git a/tools/efr32bg22/test_radio_models.py b/tools/efr32bg22/test_radio_models.py
index 5973576..a3f1e9e 100644
--- a/tools/efr32bg22/test_radio_models.py
+++ b/tools/efr32bg22/test_radio_models.py
@@ -240,6 +240,18 @@ def test_public_ble_baseline_configuration_masks(self):
             dev.DIRECTMODE: 0x00001F0F,
             dev.LRFRC: 0x000001FF,
             dev.DSATHD4: 0x07FFFFFF,
+            dev.SRCCHF: 0xEFFFF8FF,
+            dev.DSACTRL: 0xFFEFFFFF,
+            dev.DIGMIXCTRL: 0x007FFFFF,
+            dev.VTCORRCFG1: 0x7FFFFFFF,
+            dev.CGCLKSTOP: 0x0000FFFF,
+            dev.LONGRANGE: 0x7FFFFFFF,
+            dev.LONGRANGE1: 0x3FFF7FFF,
+            dev.LONGRANGE5: 0x0FFFFFFF,
+            dev.LONGRANGE6: 0xFFF7FFFF,
+            dev.VTBLETIMING: 0x0000FFF3,
+            dev.BLEIQDSAEXT1: 0x3FFFFFFF,
+            dev.REALTIMCFE: 0xE01FFFFF,
             dev.SYNCPROPERTIES: 0x000000FF,
             dev.DIGIGAINCTRL: 0x000001FF,
             dev.PADEBUG: 0x00001E00,
@@ -251,6 +263,7 @@ def test_public_ble_baseline_configuration_masks(self):
             dev.CFGANTPATT: 0x3FFFFFFF,
             dev.ETSTIM: 0x0003FFFF,
             dev.ANTSWCTRL1: 0x00FFFFFF,
+            dev.COCURRMODE: 0x80000000,
             dev.ANTDIVCTRL: 0x000001FF,
             dev.BLEIQDSAEXT2: 0x000007FF,
         }
-- 
2.55.0

