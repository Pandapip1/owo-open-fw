From 86a7a0a16af096157a902d8051dc37d58dc7e829 Mon Sep 17 00:00:00 2001
From: Gavin John <gavinnjohn@gmail.com>
Date: Mon, 19 Oct 2026 14:10:07 -0400
Subject: [PATCH] efr32bg22: retain public FRC dynamic-length control

Expose the decoded DFLCTRL register mask without modelling frame parsing.

Assisted-By: Codex (GPT-5)
---
 tools/efr32bg22/models.py            | 3 ++-
 tools/efr32bg22/test_radio_models.py | 2 ++
 2 files changed, 4 insertions(+), 1 deletion(-)

diff --git a/tools/efr32bg22/models.py b/tools/efr32bg22/models.py
index 319754b..fcc37d8 100644
--- a/tools/efr32bg22/models.py
+++ b/tools/efr32bg22/models.py
@@ -472,11 +472,12 @@ class FRC(Dev):
     FRC/SEQ behavior and is deliberately not modelled here.  Retaining these
     public register masks makes the source-backed BLE setup observable.
     """
-    MAXLENGTH = 0x010
+    DFLCTRL, MAXLENGTH = 0x00C, 0x010
     WHITECTRL, WHITEPOLY, WHITEINIT = 0x030, 0x034, 0x038
     CTRL = 0x048
     FCD0, FCD1, FCD2, FCD3 = 0x104, 0x108, 0x10C, 0x110
     MASKS = {
+        DFLCTRL: 0x01FFFF7F,
         MAXLENGTH: 0x0000FFFF,
         WHITECTRL: 0x00001F7F,
         WHITEPOLY: 0x0000FFFF,
diff --git a/tools/efr32bg22/test_radio_models.py b/tools/efr32bg22/test_radio_models.py
index ba765e5..f8b8337 100644
--- a/tools/efr32bg22/test_radio_models.py
+++ b/tools/efr32bg22/test_radio_models.py
@@ -145,10 +145,12 @@ def test_public_whitening_configuration_masks(self):
 
     def test_public_ble_frame_configuration_masks(self):
         _, dev = attach(models.FRC("FRC"))
+        dev.write(dev.DFLCTRL, 0xFE018101)
         dev.write(dev.MAXLENGTH, 0xFFFF4101)
         dev.write(dev.CTRL, 0xFFFF07A0)
         for off in (dev.FCD0, dev.FCD1, dev.FCD2, dev.FCD3):
             dev.write(off, 0xFFFF4CFF)
+        self.assertEqual(dev.read(dev.DFLCTRL), 0x00018101)
         self.assertEqual(dev.read(dev.MAXLENGTH), 0x00004101)
         self.assertEqual(dev.read(dev.CTRL), 0x001F07A0)
         for off in (dev.FCD0, dev.FCD1, dev.FCD2, dev.FCD3):
-- 
2.55.0

