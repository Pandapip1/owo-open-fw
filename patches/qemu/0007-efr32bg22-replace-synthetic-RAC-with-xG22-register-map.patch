From b7bff4ae172917dfa1f9a126c53e16b7d7ea68dd Mon Sep 17 00:00:00 2001
From: Gavin John <gavinnjohn@gmail.com>
Date: Mon, 19 Oct 2026 13:25:05 -0400
Subject: [PATCH] efr32bg22: replace synthetic RAC with xG22 register map

Use the public revB2 RAC layout for commands, status states, software RX enable, and the distinct RSM/SEQ interrupt banks.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>

Claude-Session: https://claude.ai/code/session_01PdMVRPYdkoKYyoN2UWrcnz
---
 tools/efr32bg22/models.py            | 95 +++++++++++++++++++++-------
 tools/efr32bg22/test_radio_models.py | 44 +++++++++----
 2 files changed, 104 insertions(+), 35 deletions(-)

diff --git a/tools/efr32bg22/models.py b/tools/efr32bg22/models.py
index 483fad2..f64500c 100644
--- a/tools/efr32bg22/models.py
+++ b/tools/efr32bg22/models.py
@@ -328,42 +328,93 @@ def contents(self, n):
         return bytes(self.data[n])
 
 
-class SimRAC(IrqDev):
-    """Simulator-only radio state machine; not an asserted xG22 register map.
+class RAC(Dev):
+    """EFR32xG22 RAC command/state and interrupt core.
 
-    CMD(+0x10): 1=disable, 2=RX, 3=TX. STATUS(+0x14): 0=idle, 1=RX,
-    2=TX. EVENT IF/IEN are +0x18/+0x1c, bit 0. TX completes after 150 us;
-    RX remains active until disabled.  Keeping this contract separate and named
-    SIM_* prevents these offsets being mistaken for hardware facts.
+    The register layout and field names are from Silicon Labs' public generated
+    revB2 register model.  Packet modulation remains deliberately abstract: a
+    TXEN/FORCETX command enters state 9 (TX), then completes after 150 us.
+    RXENSRCEN.SWRXEN enters state 2 (RXSEARCH) until RXDIS clears it.
     """
-    IF_OFF, IEN_OFF = 0x018, 0x01C
-    irq_name = "RAC_SEQ"
-    IDLE, RX, TX = 0, 1, 2
+    RXENSRCEN, STATUS, CMD = 0x008, 0x00C, 0x010
+    IF_OFF, IEN_OFF = 0x01C, 0x020
+    SEQIF_OFF, SEQIEN_OFF = 0x028, 0x02C
+
+    CMD_TXEN = 1 << 0
+    CMD_FORCETX = 1 << 1
+    CMD_TXDIS = 1 << 5
+    CMD_RXCAL = 1 << 7
+    CMD_RXDIS = 1 << 8
+
+    STATEOFF, STATERXSEARCH, STATETX = 0, 2, 9
+    IF_STATECHANGE = 1 << 0
+    SEQ_STATEOFF = 1 << 16
+    SEQ_STATERXSEARCH = 1 << 18
+    SEQ_STATETX = 1 << 25
 
     def __init__(self, name):
         super().__init__(name, "")
-        self.state = self.IDLE
+        self.state = self.STATEOFF
         self.generation = 0
 
-    def r_014(self):
-        return self.state
+    def status(self):
+        active = self.state != self.STATEOFF
+        tx = self.state == self.STATETX
+        rx = self.state == self.STATERXSEARCH
+        return self.state << 24 | active << 28 | tx << 30 | rx << 31
+
+    def r_00c(self):
+        return self.status()
+
+    def irq_update(self):
+        rsm = resets.IRQS.get("RAC_RSM")
+        seq = resets.IRQS.get("RAC_SEQ")
+        if rsm is not None:
+            self.m.set_irq(rsm, bool(self.regs.get(self.IF_OFF, 0) &
+                                     self.regs.get(self.IEN_OFF, 0)))
+        if seq is not None:
+            self.m.set_irq(seq, bool(self.regs.get(self.SEQIF_OFF, 0) &
+                                     self.regs.get(self.SEQIEN_OFF, 0)))
+
+    def set_state(self, state, seq_flag):
+        if state == self.state:
+            return
+        self.state = state
+        self.regs[self.IF_OFF] = self.regs.get(self.IF_OFF, 0) | self.IF_STATECHANGE
+        self.regs[self.SEQIF_OFF] = self.regs.get(self.SEQIF_OFF, 0) | seq_flag
+        self.irq_update()
+
+    def write(self, off, val):
+        if off == self.RXENSRCEN:
+            self.regs[off] = val & 0x3FFF
+            if val & 0xFF:
+                self.generation += 1
+                self.set_state(self.STATERXSEARCH, self.SEQ_STATERXSEARCH)
+            elif self.state == self.STATERXSEARCH:
+                self.generation += 1
+                self.set_state(self.STATEOFF, self.SEQ_STATEOFF)
+            return
+        super().write(off, val)
+        if off in (self.IF_OFF, self.IEN_OFF, self.SEQIF_OFF, self.SEQIEN_OFF):
+            self.irq_update()
 
     def w_010(self, value):
         self.generation += 1
         generation = self.generation
-        if value == 1:
-            self.state = self.IDLE
-        elif value == 2:
-            self.state = self.RX
-        elif value == 3:
-            self.state = self.TX
+        if value & (self.CMD_TXDIS | self.CMD_RXDIS):
+            self.set_state(self.STATEOFF, self.SEQ_STATEOFF)
+        elif value & (self.CMD_TXEN | self.CMD_FORCETX):
+            self.set_state(self.STATETX, self.SEQ_STATETX)
             def complete():
-                if generation == self.generation and self.state == self.TX:
-                    self.state = self.IDLE
-                    self.raise_if(1)
+                if generation == self.generation and self.state == self.STATETX:
+                    self.set_state(self.STATEOFF, self.SEQ_STATEOFF)
             self.m.after(150_000, complete)
 
 
+# Compatibility for out-of-tree scripts written against patch 0006.
+SimRAC = RAC
+
+
 class PCF8575:
     """16-bit quasi-bidirectional I/O expander.  Two data bytes per transfer, P0-P7 first."""
     def __init__(self, addr7=0x20):
@@ -1181,7 +1232,7 @@ def build(m, reset=False, cause=1):
     m.add(IADC("IADC0"), 0x4A004000)
     m.add(USART("USART0", "USART0_RX"), 0x4005C000)
     m.add(USART("USART1", "USART1_RX"), 0x40060000)
-    m.rac = m.add(SimRAC("RAC_SIM"), 0xA8020000)
+    m.rac = m.add(RAC("RAC"), 0xA8020000)
     m.bufc = m.add(BUFC("BUFC"), 0xAA000000)
     trng = m.add(TRNG("TRNG", ""), 0x4C021000, 0x1000)
     m.add(TRNGFifo("TRNGFIFO", trng), 0x4C024000, 0x1000)
diff --git a/tools/efr32bg22/test_radio_models.py b/tools/efr32bg22/test_radio_models.py
index ca706e1..cfb6dcf 100644
--- a/tools/efr32bg22/test_radio_models.py
+++ b/tools/efr32bg22/test_radio_models.py
@@ -66,25 +66,43 @@ def test_xwrite_clear_threshold_and_irq(self):
         self.assertFalse(machine.irq & (1 << models.resets.IRQS["BUFC"]))
 
 
-class SimRacTests(unittest.TestCase):
-    def test_tx_completes_and_raises_rac_seq(self):
-        machine, dev = attach(models.SimRAC("RAC_SIM"))
-        dev.write(dev.IEN_OFF, 1)
-        dev.write(0x10, 3)
-        self.assertEqual(dev.read(0x14), dev.TX)
+class RacTests(unittest.TestCase):
+    def test_tx_completes_and_raises_real_rac_seq(self):
+        machine, dev = attach(models.RAC("RAC"))
+        dev.write(dev.SEQIEN_OFF, dev.SEQ_STATEOFF)
+        dev.write(dev.CMD, dev.CMD_TXEN)
+        self.assertEqual((dev.read(dev.STATUS) >> 24) & 0xF, dev.STATETX)
+        self.assertTrue(dev.read(dev.STATUS) & (1 << 30))
         machine.advance(149_999)
-        self.assertEqual(dev.read(0x14), dev.TX)
+        self.assertEqual((dev.read(dev.STATUS) >> 24) & 0xF, dev.STATETX)
         machine.advance(1)
-        self.assertEqual(dev.read(0x14), dev.IDLE)
+        self.assertEqual((dev.read(dev.STATUS) >> 24) & 0xF, dev.STATEOFF)
         self.assertTrue(machine.irq & (1 << models.resets.IRQS["RAC_SEQ"]))
 
     def test_disable_cancels_pending_tx_completion(self):
-        machine, dev = attach(models.SimRAC("RAC_SIM"))
-        dev.write(0x10, 3)
-        dev.write(0x10, 1)
+        machine, dev = attach(models.RAC("RAC"))
+        dev.write(dev.CMD, dev.CMD_FORCETX)
+        dev.write(dev.CMD, dev.CMD_TXDIS)
         machine.advance(150_000)
-        self.assertEqual(dev.read(0x14), dev.IDLE)
-        self.assertEqual(dev.read(dev.IF_OFF), 0)
+        self.assertEqual((dev.read(dev.STATUS) >> 24) & 0xF, dev.STATEOFF)
+
+    def test_software_rx_enable_and_rx_disable(self):
+        _, dev = attach(models.RAC("RAC"))
+        dev.write(dev.RXENSRCEN, 1)
+        self.assertEqual((dev.read(dev.STATUS) >> 24) & 0xF,
+                         dev.STATERXSEARCH)
+        self.assertTrue(dev.read(dev.STATUS) & (1 << 31))
+        dev.write(dev.CMD, dev.CMD_RXDIS)
+        self.assertEqual((dev.read(dev.STATUS) >> 24) & 0xF, dev.STATEOFF)
+
+    def test_rsm_and_seq_interrupts_are_distinct(self):
+        machine, dev = attach(models.RAC("RAC"))
+        dev.write(dev.IEN_OFF, dev.IF_STATECHANGE)
+        dev.write(dev.RXENSRCEN, 1)
+        self.assertTrue(machine.irq & (1 << models.resets.IRQS["RAC_RSM"]))
+        self.assertFalse(machine.irq & (1 << models.resets.IRQS["RAC_SEQ"]))
+        dev.write(dev.SEQIEN_OFF, dev.SEQ_STATERXSEARCH)
+        self.assertTrue(machine.irq & (1 << models.resets.IRQS["RAC_SEQ"]))
 
 
 if __name__ == "__main__":
