From b9a150f2cb776ae91393218f230e84d9a636b5a3 Mon Sep 17 00:00:00 2001
From: Gavin John <gavinnjohn@gmail.com>
Date: Mon, 19 Oct 2026 15:12:58 -0400
Subject: [PATCH] efr32: retain FRC RX and packet-buffer controls

Assisted-By: Codex (GPT-5)
---
 tools/efr32bg22/models.py            | 5 ++++-
 tools/efr32bg22/test_radio_models.py | 7 +++++++
 2 files changed, 11 insertions(+), 1 deletion(-)

diff --git a/tools/efr32bg22/models.py b/tools/efr32bg22/models.py
index 4042034..1e85da5 100644
--- a/tools/efr32bg22/models.py
+++ b/tools/efr32bg22/models.py
@@ -482,10 +482,11 @@ class FRC(Dev):
     WCNTCMP0, WCNTCMP1 = 0x020, 0x024
     WHITECTRL, WHITEPOLY, WHITEINIT = 0x030, 0x034, 0x038
     FECCTRL, BLOCKRAMADDR, CONVRAMADDR = 0x03C, 0x040, 0x044
-    CTRL, TRAILTXDATACTRL = 0x048, 0x050
+    CTRL, RXCTRL, TRAILTXDATACTRL = 0x048, 0x04C, 0x050
     CONVGENERATOR, PUNCTCTRL = 0x05C, 0x060
     AUTOCG = 0x0A8
     WCNTCMP3, BOICTRL, DSLCTRL, WCNTCMP4 = 0x0BC, 0x0C0, 0x0C4, 0x0C8
+    PKTBUFCTRL = 0x0CC
     FCD0, FCD1, FCD2, FCD3 = 0x104, 0x108, 0x10C, 0x110
     MASKS = {
         DFLCTRL: 0x01FFFF7F,
@@ -499,6 +500,7 @@ class FRC(Dev):
         BLOCKRAMADDR: 0xFFFFFFFC,
         CONVRAMADDR: 0xFFFFFFFC,
         CTRL: 0x001F3FF7,
+        RXCTRL: 0x000007FF,
         TRAILTXDATACTRL: 0x007FFFFF,
         CONVGENERATOR: 0x00037F7F,
         PUNCTCTRL: 0x00007F7F,
@@ -507,6 +509,7 @@ class FRC(Dev):
         BOICTRL: 0x0001FFFF,
         DSLCTRL: 0x7FFFFF7F,
         WCNTCMP4: 0x00000FFF,
+        PKTBUFCTRL: 0x0103FFFF,
         FCD0: 0x0001FFFF,
         FCD1: 0x0001FFFF,
         FCD2: 0x0001FFFF,
diff --git a/tools/efr32bg22/test_radio_models.py b/tools/efr32bg22/test_radio_models.py
index 0e4d6b1..5fa4ce1 100644
--- a/tools/efr32bg22/test_radio_models.py
+++ b/tools/efr32bg22/test_radio_models.py
@@ -188,6 +188,13 @@ def test_public_ble_baseline_configuration_masks(self):
             dev.write(off, 0xFFFFFFFF)
             self.assertEqual(dev.read(off), expected)
 
+    def test_public_rx_and_packet_buffer_configuration_masks(self):
+        _, dev = attach(models.FRC("FRC"))
+        dev.write(dev.RXCTRL, 0xFFFF07FF)
+        dev.write(dev.PKTBUFCTRL, 0xFFFFFFFF)
+        self.assertEqual(dev.read(dev.RXCTRL), 0x000007FF)
+        self.assertEqual(dev.read(dev.PKTBUFCTRL), 0x0103FFFF)
+
 
 class GuestMemoryTests(unittest.TestCase):
     def test_model_guest_read_delegates_to_bridge_transport(self):
