From afd76ffce3123c03afc30d0f36caa8005b49f6fc Mon Sep 17 00:00:00 2001
From: Gavin John <gavinnjohn@gmail.com>
Date: Mon, 19 Oct 2026 14:06:07 -0400
Subject: [PATCH] efr32bg22: model public MODEM sync-word register

Retain the public SYNC0 configuration register without claiming packet matching behavior.

Assisted-By: Codex (GPT-5)
---
 tools/efr32bg22/models.py            | 16 ++++++++++++++++
 tools/efr32bg22/test_radio_models.py |  7 +++++++
 2 files changed, 23 insertions(+)

diff --git a/tools/efr32bg22/models.py b/tools/efr32bg22/models.py
index 2236b4a..dfea883 100644
--- a/tools/efr32bg22/models.py
+++ b/tools/efr32bg22/models.py
@@ -486,6 +486,21 @@ def write(self, off, val):
             super().write(off, val)
 
 
+class Modem(Dev):
+    """Public xG22 MODEM sync-word register.
+
+    This preserves software-visible programming only.  Sync detection and
+    interpreting a value as a Bluetooth access address are FRC/SEQ behavior.
+    """
+    SYNC0 = 0x068
+
+    def write(self, off, val):
+        if off == self.SYNC0:
+            self.regs[off] = val & 0xFFFFFFFF
+        else:
+            super().write(off, val)
+
+
 class PCF8575:
     """16-bit quasi-bidirectional I/O expander.  Two data bytes per transfer, P0-P7 first."""
     def __init__(self, addr7=0x20):
@@ -1307,6 +1322,7 @@ def build(m, reset=False, cause=1):
     m.synth = m.add(Synth("SYNTH"), 0xA8018000)
     m.rfcrc = m.add(RFCRC("RFCRC"), 0xA8010000)
     m.frc = m.add(FRC("FRC"), 0xA8004000)
+    m.modem = m.add(Modem("MODEM"), 0xA8014000)
     m.bufc = m.add(BUFC("BUFC"), 0xAA000000)
     trng = m.add(TRNG("TRNG", ""), 0x4C021000, 0x1000)
     m.add(TRNGFifo("TRNGFIFO", trng), 0x4C024000, 0x1000)
diff --git a/tools/efr32bg22/test_radio_models.py b/tools/efr32bg22/test_radio_models.py
index f3b2d13..002be08 100644
--- a/tools/efr32bg22/test_radio_models.py
+++ b/tools/efr32bg22/test_radio_models.py
@@ -144,5 +144,12 @@ def test_public_whitening_configuration_masks(self):
         self.assertEqual(dev.read(dev.WHITEINIT), 0x00001234)
 
 
+class ModemTests(unittest.TestCase):
+    def test_public_sync0_is_a_32_bit_configuration_register(self):
+        _, dev = attach(models.Modem("MODEM"))
+        dev.write(dev.SYNC0, 0x89ABCDEF)
+        self.assertEqual(dev.read(dev.SYNC0), 0x89ABCDEF)
+
+
 if __name__ == "__main__":
     unittest.main()
-- 
