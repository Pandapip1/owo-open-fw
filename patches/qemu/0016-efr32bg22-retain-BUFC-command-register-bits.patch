From e3c893c3562fff4a5e375f5a605ca54b861fdcec Mon Sep 17 00:00:00 2001
From: Gavin John <gavinnjohn@gmail.com>
Date: Mon, 19 Oct 2026 14:37:08 -0400
Subject: [PATCH] efr32bg22: retain BUFC command register bits

Model the public command mask while keeping the traced unnamed command bit behavior-free.

Assisted-By: Codex (GPT-5)
---
 tools/efr32bg22/models.py            | 1 +
 tools/efr32bg22/test_radio_models.py | 6 ++++++
 2 files changed, 7 insertions(+)

diff --git a/tools/efr32bg22/models.py b/tools/efr32bg22/models.py
index 226a4f2..7a20782 100644
--- a/tools/efr32bg22/models.py
+++ b/tools/efr32bg22/models.py
@@ -314,6 +314,7 @@ def write(self, off, val):
         elif reg == 0x1C:                       # XWRITE
             self.push(n, val & 0xFF, xor=True)
         elif reg == 0x28:                       # CMD
+            self.regs[base + reg] = val & 0xF   # public xG21 CMD mask; bit 2 is unassigned there.
             if val & 1:                         # CLEAR
                 self.data[n].clear()
                 self.regs[base + 0x08] = self.regs[base + 0x0C] = 0
diff --git a/tools/efr32bg22/test_radio_models.py b/tools/efr32bg22/test_radio_models.py
index f0d0b77..78419c1 100644
--- a/tools/efr32bg22/test_radio_models.py
+++ b/tools/efr32bg22/test_radio_models.py
@@ -66,6 +66,12 @@ def test_xwrite_clear_threshold_and_irq(self):
         self.assertEqual(dev.contents(1), b"")
         self.assertFalse(machine.irq & (1 << models.resets.IRQS["BUFC"]))
 
+    def test_public_command_mask_retains_unassigned_trace_bit(self):
+        _, dev = attach(models.BUFC("BUFC"))
+        base = dev.BUF0 + 3 * dev.STRIDE
+        dev.write(base + 0x28, 0xF4)
+        self.assertEqual(dev.read(base + 0x28), 0x4)
+
 
 class RacTests(unittest.TestCase):
     def test_tx_completes_and_raises_real_rac_seq(self):
