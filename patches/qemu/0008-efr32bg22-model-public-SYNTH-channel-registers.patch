From dc91be71c1480f6dea6144505cc04e919c772f91 Mon Sep 17 00:00:00 2001
From: Gavin John <gavinnjohn@gmail.com>
Date: Mon, 19 Oct 2026 13:42:45 -0400
Subject: [PATCH] efr32bg22: model public SYNTH channel registers

Expose mask-correct FREQ, IFFREQ, DIVCTRL, CHCTRL, and CHSP register state from the public xG22 revB2 model.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>

Claude-Session: https://claude.ai/code/session_01PdMVRPYdkoKYyoN2UWrcnz
---
 tools/efr32bg22/models.py            | 24 ++++++++++++++++++++++++
 tools/efr32bg22/test_radio_models.py | 13 +++++++++++++
 2 files changed, 37 insertions(+)

diff --git a/tools/efr32bg22/models.py b/tools/efr32bg22/models.py
index f64500c..70bef62 100644
--- a/tools/efr32bg22/models.py
+++ b/tools/efr32bg22/models.py
@@ -415,6 +415,29 @@ def complete():
 SimRAC = RAC
 
 
+class Synth(Dev):
+    """EFR32xG22 SYNTH frequency/channel controls from the public revB2 model.
+
+    Frequency synthesis itself remains outside this bridge; retaining the
+    architecturally visible field masks lets firmware select a BLE channel and
+    makes the configuration observable to higher-level radio simulation.
+    """
+    FREQ, IFFREQ, DIVCTRL, CHCTRL, CHSP = 0x034, 0x038, 0x03C, 0x040, 0x044
+    MASKS = {
+        FREQ: 0x0FFFFFFF,
+        IFFREQ: 0x001FFFFF,
+        DIVCTRL: 0x000001FF,
+        CHCTRL: 0x0000003F,
+        CHSP: 0x0003FFFF,
+    }
+
+    def write(self, off, val):
+        if off in self.MASKS:
+            self.regs[off] = val & self.MASKS[off]
+        else:
+            super().write(off, val)
+
+
 class PCF8575:
     """16-bit quasi-bidirectional I/O expander.  Two data bytes per transfer, P0-P7 first."""
     def __init__(self, addr7=0x20):
@@ -1233,6 +1256,7 @@ def build(m, reset=False, cause=1):
     m.add(USART("USART0", "USART0_RX"), 0x4005C000)
     m.add(USART("USART1", "USART1_RX"), 0x40060000)
     m.rac = m.add(RAC("RAC"), 0xA8020000)
+    m.synth = m.add(Synth("SYNTH"), 0xA8018000)
     m.bufc = m.add(BUFC("BUFC"), 0xAA000000)
     trng = m.add(TRNG("TRNG", ""), 0x4C021000, 0x1000)
     m.add(TRNGFifo("TRNGFIFO", trng), 0x4C024000, 0x1000)
diff --git a/tools/efr32bg22/test_radio_models.py b/tools/efr32bg22/test_radio_models.py
index cfb6dcf..eba48a0 100644
--- a/tools/efr32bg22/test_radio_models.py
+++ b/tools/efr32bg22/test_radio_models.py
@@ -105,5 +105,18 @@ def test_rsm_and_seq_interrupts_are_distinct(self):
         self.assertTrue(machine.irq & (1 << models.resets.IRQS["RAC_SEQ"]))
 
 
+class SynthTests(unittest.TestCase):
+    def test_public_xg22_channel_and_frequency_field_masks(self):
+        _, dev = attach(models.Synth("SYNTH"))
+        dev.write(dev.CHCTRL, 0xFF)
+        dev.write(dev.FREQ, 0xF1234567)
+        dev.write(dev.IFFREQ, 0xFF123456)
+        dev.write(dev.CHSP, 0xFFFABCDE)
+        self.assertEqual(dev.read(dev.CHCTRL), 0x3F)
+        self.assertEqual(dev.read(dev.FREQ), 0x01234567)
+        self.assertEqual(dev.read(dev.IFFREQ), 0x00123456)
+        self.assertEqual(dev.read(dev.CHSP), 0x0002BCDE)
+
+
 if __name__ == "__main__":
     unittest.main()
