From 735cd81c15bafe673d779ae99ab9d8dd11c89960 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 19 Oct 2026 06:24:21 +0000
Subject: [PATCH 2/2] gpio: sn74hc595: optional read-back verification of the
 chain

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01PdMVRPYdkoKYyoN2UWrcnz
---
 drivers/gpio/gpio_sn74hc595.c       | 24 ++++++++++++++++++++++++
 dts/bindings/gpio/ti,sn74hc595.yaml |  7 +++++++
 2 files changed, 31 insertions(+)

diff --git a/drivers/gpio/gpio_sn74hc595.c b/drivers/gpio/gpio_sn74hc595.c
index 520c94b58..34f5db95c 100644
--- a/drivers/gpio/gpio_sn74hc595.c
+++ b/drivers/gpio/gpio_sn74hc595.c
@@ -34,6 +34,7 @@ struct gpio_sn74hc595_config {
 	struct gpio_dt_spec reset_gpio;
 
 	uint8_t num_registers;
+	bool verify_readback;
 };
 
 struct gpio_sn74hc595_drv_data {
@@ -61,6 +62,28 @@ static int sn74hc595_write(const struct device *dev, uint32_t value)
 
 	ret = spi_write_dt(&config->bus, &tx);
 
+	if (ret == 0 && config->verify_readback) {
+		/* The last register's serial output (QH') is wired to MISO: clock the chain once
+		 * more WITHOUT touching the store clock (chip select) and compare. What was just
+		 * latched stays on the outputs; the register contents are overwritten by the next
+		 * write anyway.
+		 */
+		uint8_t zeros[sizeof(uint32_t)] = {0};
+		uint8_t back[sizeof(uint32_t)];
+		struct spi_config no_cs = config->bus.config;
+		struct spi_buf zbuf = {.buf = zeros, .len = config->num_registers};
+		struct spi_buf rbuf = {.buf = back, .len = config->num_registers};
+		const struct spi_buf_set ztx = {.buffers = &zbuf, .count = 1};
+		const struct spi_buf_set rrx = {.buffers = &rbuf, .count = 1};
+
+		no_cs.cs = (struct spi_cs_control){0};
+		ret = spi_transceive(config->bus.bus, &no_cs, &ztx, &rrx);
+		if (ret == 0 && memcmp(back, &adjusted_value, config->num_registers) != 0) {
+			LOG_ERR("read-back mismatch");
+			ret = -EIO;
+		}
+	}
+
 	if (ret == 0) {
 		drv_data->output = value;
 	}
@@ -225,6 +248,7 @@ static int gpio_sn74hc595_init(const struct device *dev)
 		.reset_gpio = GPIO_DT_SPEC_INST_GET_OR(n, reset_gpios, {0}),                       \
 		.enable_gpio = GPIO_DT_SPEC_INST_GET_OR(n, enable_gpios, {0}),                     \
 		.num_registers = DT_INST_PROP(n, ngpios) / BITS_PER_BYTE,                          \
+		.verify_readback = DT_INST_PROP(n, verify_readback),                          \
 	};                                                                                         \
                                                                                                    \
 	DEVICE_DT_DEFINE(DT_DRV_INST(n), &gpio_sn74hc595_init, NULL, &sn74hc595_data_##n,          \
diff --git a/dts/bindings/gpio/ti,sn74hc595.yaml b/dts/bindings/gpio/ti,sn74hc595.yaml
index cdc25f051..0c35501b3 100644
--- a/dts/bindings/gpio/ti,sn74hc595.yaml
+++ b/dts/bindings/gpio/ti,sn74hc595.yaml
@@ -39,6 +39,13 @@ properties:
       specific state and or you don't have control over the hard reset input of
       the register(s).
 
+  verify-readback:
+    type: boolean
+    description: |
+      The serial output of the last register is wired back to the SPI controller's MISO. After
+      every update the driver clocks the chain once more without touching the store clock (chip
+      select) and fails the update with -EIO if what comes back differs from what was written.
+
   ngpios:
     type: int
     required: true
