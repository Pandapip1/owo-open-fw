# cmake -DNM=<nm> -DELF=<sequencer.elf> -DOUT=<header> -P syms.cmake: the decision's address in
# the image (the assembly one does not export it, so the symbol table is read).
execute_process(COMMAND ${NM} ${ELF} OUTPUT_VARIABLE syms RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "${NM} ${ELF} failed")
endif()
string(REGEX MATCH "([0-9a-f]+) [tT] efr32_seq_conn_decide\n" m "${syms}")
if(NOT m)
  message(FATAL_ERROR "efr32_seq_conn_decide not in ${ELF}")
endif()
file(WRITE ${OUT}
  "/* Generated by syms.cmake; do not edit. */\n"
  "#define SEQ_DECIDE_ADDR 0x${CMAKE_MATCH_1}U\n")
