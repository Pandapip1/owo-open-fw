/* Hardware smoke-test routing for the BGM220 Explorer Kit. */
&bt_hci_silabs {
	status = "disabled";
};

&radio {
	bt_hci_efr32: bt_hci_efr32 {
		compatible = "zephyr,bt-hci-ll-sw-split";
		status = "okay";
	};
};

/ {
	chosen {
		zephyr,bt-hci = &bt_hci_efr32;
	};
};

&burtc0 {
	status = "okay";
};

&timer0 {
	status = "okay";

	counter {
		status = "okay";
	};
};
