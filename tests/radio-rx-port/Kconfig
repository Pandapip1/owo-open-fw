# Test-only configuration for the EFR32 QEMU scanner workload.

menu "EFR32 radio RX-port test"

config RADIO_RX_PORT_ACTIVE_SCAN
	bool "Exercise active scanning in the QEMU RX-port workload"
	depends on BT_OBSERVER
	default n
	help
	  Use the host's active scan parameter rather than the default passive
	  parameter. This is solely an in-tree QEMU integration workload: it
	  expects the EFR32 HAL's separately gated QEMU RX-to-TX turn-around to
	  send a staged SCAN_REQ, then receive the advertiser's SCAN_RSP. Do not
	  select it for a hardware build; silicon packet-end/TIFS semantics are
	  not established.

config RADIO_RX_PORT_CENTRAL
	bool "Exercise central connection establishment in the QEMU RX-port workload"
	depends on BT_CENTRAL
	default n
	help
	  Replace the scanner-only workload with a central that scans for the
	  connectable advertiser and issues bt_conn_le_create(). This is solely
	  an in-tree QEMU integration workload: it requires the QEMU RX-to-TX
	  turn-around to deliver CONNECT_IND to the advertiser and the first
	  connection-event packet back. Do not select it for a hardware build.

config RADIO_RX_PORT_PAIRING
	bool "Pair with LE Secure Connections and a passkey before the GATT rounds"
	depends on RADIO_RX_PORT_CENTRAL && BT_SMP
	help
	  Once connected, request security level 4 (LE Secure Connections, authenticated),
	  enter RADIO_RX_PORT_PASSKEY as a keyboard-only device, and run the GATT rounds only on
	  the encrypted link. prj-central-pairing.conf.

config RADIO_RX_PORT_PASSKEY
	int "Passkey the Central enters"
	depends on RADIO_RX_PORT_PAIRING
	range 0 999999
	default 123456
	help
	  The radio-port advertiser's RADIO_PORT_PASSKEY, or the product's (the Jenkins
	  one-at-a-time hash of its serial modulo 10^6, crates/owo-core proto::pairing_code();
	  426134 for the default serial 000000000000).

config RADIO_RX_PORT_PEER_PRODUCT
	bool "The Peripheral is the product image"
	depends on RADIO_RX_PORT_PAIRING
	help
	  Run the GATT rounds on the product's "Test" characteristic (src/ble.rs: a 20-octet value
	  written and read back, authenticated encrypted link only) instead of the radio-port
	  test characteristic. prj-central-product.conf.

config RADIO_RX_PORT_PEER_PRODUCT_STIM
	bool "Command stimulation on the product over the link"
	depends on RADIO_RX_PORT_PEER_PRODUCT
	help
	  Between the GATT rounds, command the product as its app does, over the encrypted link:
	  enable notifications on "Start / Stop" and "Extra 2", then every
	  CENTRAL_STIM_EVERY rounds write the pulse widths, Start (0x25), a 5 s frame and a frame
	  with a bad checksum (answered by a notification), and every second cycle Stop (0x00).
	  For measuring the product's Bluetooth RX thread on the stimulation paths
	  (write_cb, the output's stop and start, notifications). prj-central-product-stim.conf.

endmenu

# Module defaults that must precede Zephyr's own (modules/efr32-radio/Kconfig.defaults).
osource "$(ZEPHYR_EFR32_RADIO_MODULE_DIR)/Kconfig.defaults"
source "Kconfig.zephyr"
