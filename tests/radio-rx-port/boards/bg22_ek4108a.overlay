/* Use Zephyr's split controller rather than Silicon Labs' binary controller. */
&bt_hci_silabs {
	status = "disabled";
};

&radio {
	bt_hci_efr32: bt_hci_efr32 {
		compatible = "zephyr,bt-hci-ll-sw-split";
		status = "okay";
	};
};

/ {
	chosen {
		zephyr,bt-hci = &bt_hci_efr32;
	};
};

&burtc0 {
	status = "okay";
};

/* HFXO-clocked 32-bit TIMER0: the scheduler clock's active-state provider. */
&timer0 {
	status = "okay";

	counter {
		status = "okay";
	};
};
